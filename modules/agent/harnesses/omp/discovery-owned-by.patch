+	/** Rows of a `discovery.authoritative` provider survive only when its discovery returned their id. */
+	#dropUndiscoveredRows(models: Model<Api>[]): Model<Api>[] {
+		const discoveredIds = new Map<string, Set<string>>();
+		for (const providerConfig of this.#discoverableProviders) {
+			if (providerConfig.discovery.authoritative) discoveredIds.set(providerConfig.provider, new Set());
+		}
+		if (discoveredIds.size === 0) return models;
+		for (const model of this.#cachedDiscoverableModels) discoveredIds.get(model.provider)?.add(model.id);
+		for (const model of this.#runtimeDiscoveredModels) discoveredIds.get(model.provider)?.add(model.id);
+		return models.filter(model => discoveredIds.get(model.provider)?.has(model.id) ?? true);
+	}
