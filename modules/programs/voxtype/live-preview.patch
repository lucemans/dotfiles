+//! Streaming transcription against a NeMo-Speech server (`nemo-speech serve`).
+//!
+//! Selected with `[whisper] mode = "remote"` and `remote_realtime = true`.
+//! Audio goes over the server's realtime WebSocket as it is captured, words
+//! are typed as soon as they are complete and settled, and vocabulary files
+//! (re-read at every recording start) boost terms and correct text. Batch
+//! transcription falls back to the server's HTTP endpoint with the same
+//! vocabulary.
+//!
+//! - [`protocol`]: wire messages and the running hypothesis.
+//! - [`stream_text`]: which words to type when, and how to reconcile with the
+//!   server's final transcript. No I/O.
+//! - [`vocabulary`]: the vocabulary file format.
+//! - [`session`]: the socket conversation for one recording.
+
+mod protocol;
+mod session;
+mod stream_text;
+pub mod vocabulary;
+
+#[cfg(test)]
+mod tests;
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use tokio::sync::{mpsc, oneshot};
+
+use self::session::Session;
+use self::stream_text::LiveText;
+use self::vocabulary::Vocabulary;
+use super::remote::RemoteTranscriber;
+use super::streaming::{StreamHandle, StreamingEvent, StreamingTranscriber};
+use super::Transcriber;
+use crate::config::{Config, TextConfig};
+use crate::error::TranscribeError;
+use crate::text::TextProcessor;
+
+/// Events the daemon has not consumed yet. Typing is slower than recognition,
+/// and a full queue stalls audio forwarding, so this is deliberately deep:
+/// 64 events is several seconds of speech at one event per chunk.
+const EVENT_QUEUE: usize = 64;
+
+/// Remote transcriber that streams audio over the realtime WebSocket.
+pub struct RealtimeTranscriber {
+    batch: RemoteTranscriber,
+    url: String,
+    text: TextConfig,
+    language: Option<String>,
+    vocabulary_files: Vec<String>,
+    boost: f32,
+}
+
+impl RealtimeTranscriber {
+    pub fn new(config: &Config) -> Result<Self, TranscribeError> {
+        let batch = RemoteTranscriber::new(&config.whisper)?;
+        let url = protocol::websocket_url(batch.endpoint())?;
+        tracing::info!(
+            realtime.url = %url,
+            vocabulary.files = config.whisper.vocabulary_files.len(),
+            boost = config.whisper.remote_boost,
+            "Configured realtime transcriber"
+        );
+        Ok(Self {
+            batch,
+            url,
+            text: config.text.clone(),
+            language: config.active_language().map(str::to_owned),
+            vocabulary_files: config.whisper.vocabulary_files.clone(),
+            boost: config.whisper.remote_boost,
+        })
+    }
+
+    /// Read the vocabulary files now, so edits apply to the next recording.
+    fn vocabulary(&self) -> Vocabulary {
+        let home: Option<PathBuf> = dirs::home_dir();
+        Vocabulary::load(&self.vocabulary_files, home.as_deref())
+    }
+
+    /// `[text]` options with the vocabulary's corrections added. A correction
+    /// replaces a `[text.replacements]` entry for the same phrase.
+    fn text_config(&self, vocabulary: &Vocabulary) -> TextConfig {
+        let mut replacements: HashMap<String, String> = self
+            .text
+            .replacements
+            .iter()
+            .map(|(from, to)| (from.to_lowercase(), to.clone()))
+            .collect();
+        for correction in vocabulary.corrections() {
+            replacements.insert(correction.from.to_lowercase(), correction.to.clone());
+        }
+        TextConfig {
+            replacements,
+            ..self.text.clone()
+        }
+    }
+}
+
+impl Transcriber for RealtimeTranscriber {
+    /// Batch fallback: post the whole recording to the HTTP endpoint with the
+    /// vocabulary as `speech_contexts`, then apply the vocabulary's corrections.
+    /// The daemon applies `[text]` processing to batch results itself.
+    fn transcribe(&self, samples: &[f32]) -> Result<String, TranscribeError> {
+        let vocabulary = self.vocabulary();
+        let contexts = vocabulary
+            .speech_contexts(self.boost)
+            .map(|contexts| contexts.to_string());
+        let text = self
+            .batch
+            .clone()
+            .with_speech_contexts(contexts)
+            .transcribe(samples)?;
+        let corrections = TextConfig {
+            replacements: vocabulary
+                .corrections()
+                .iter()
+                .map(|correction| (correction.from.to_lowercase(), correction.to.clone()))
+                .collect(),
+            spoken_punctuation: false,
+            smart_auto_submit: false,
+            filter_filler_words: false,
+            ..TextConfig::default()
+        };
+        Ok(TextProcessor::new(&corrections).process(&text))
+    }
+
+    fn as_streaming(&self) -> Option<&dyn StreamingTranscriber> {
+        Some(self)
+    }
+}
+
+impl StreamingTranscriber for RealtimeTranscriber {
+    fn start_stream(
+        &self,
+        samples_rx: mpsc::Receiver<Vec<f32>>,
+    ) -> Result<StreamHandle, TranscribeError> {
+        let vocabulary = self.vocabulary();
+        let processor = TextProcessor::new_for_language(
+            &self.text_config(&vocabulary),
+            self.language.as_deref(),
+        );
+        tracing::info!(
+            vocabulary.terms = vocabulary.boosted().len(),
+            vocabulary.corrections = vocabulary.corrections().len(),
+            "Starting realtime session"
+        );
+        let session = Session {
+            url: self.url.clone(),
+            api_key: self.batch.api_key().map(str::to_owned),
+            update: protocol::session_update(vocabulary.speech_contexts(self.boost)),
+            live: LiveText::new(processor),
+        };
+
+        let (events_tx, events_rx) = mpsc::channel::<StreamingEvent>(EVENT_QUEUE);
+        let (cancel_tx, cancel_rx) = oneshot::channel::<()>();
+        let task = tokio::spawn(async move {
+            session::run(session, samples_rx, events_tx, cancel_rx).await;
+            Ok(())
+        });
+        Ok(StreamHandle {
+            events: events_rx,
+            cancel: cancel_tx,
+            task,
+        })
+    }
+}
