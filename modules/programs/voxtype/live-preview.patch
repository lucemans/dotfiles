+/// Streams a WAV file through the real transcriber at real-time pace and
+/// prints when each event arrived. Needs a running `nemo-speech serve`:
+///
+/// ```text
+/// VOXTYPE_LIVE_ENDPOINT=http://127.0.0.1:8010 VOXTYPE_LIVE_WAV=clip.wav \
+///   [VOXTYPE_LIVE_VOCABULARY=vocabulary.txt] \
+///   cargo test --lib live_server -- --ignored --nocapture
+/// ```
+///
+/// The WAV must be 16 kHz mono 16-bit. Run `ffmpeg -i in.flac -ar 16000 -ac 1 out.wav` first.
+#[tokio::test]
+#[ignore = "needs a running nemo-speech server (VOXTYPE_LIVE_ENDPOINT, VOXTYPE_LIVE_WAV)"]
+async fn live_server_streams_a_wav_at_real_time_pace() {
+    use std::time::Instant;
+
+    let endpoint = std::env::var("VOXTYPE_LIVE_ENDPOINT").expect("VOXTYPE_LIVE_ENDPOINT");
+    let wav = std::env::var("VOXTYPE_LIVE_WAV").expect("VOXTYPE_LIVE_WAV");
+    let samples: Vec<f32> = hound::WavReader::open(&wav)
+        .expect("open wav")
+        .samples::<i16>()
+        .map(|sample| f32::from(sample.expect("sample")) / 32768.0)
+        .collect();
+
+    let mut config = config_for(&endpoint);
+    if let Ok(file) = std::env::var("VOXTYPE_LIVE_VOCABULARY") {
+        config.whisper.vocabulary_files = vec![file];
+    }
+    let transcriber = RealtimeTranscriber::new(&config).expect("transcriber");
+    let (tx, rx) = mpsc::channel(64);
+    let started = Instant::now();
+    let mut handle = transcriber
+        .as_streaming()
+        .expect("streaming")
+        .start_stream(rx)
+        .expect("start");
+
+    // The microphone delivers 100 ms of audio every 100 ms.
+    let feeder = tokio::spawn(async move {
+        let mut chunks = 0u32;
+        for chunk in samples.chunks(1600) {
+            chunks += 1;
+            tokio::time::sleep_until(
+                tokio::time::Instant::from_std(started) + Duration::from_millis(100) * chunks,
+            )
+            .await;
+            tx.send(chunk.to_vec()).await.expect("audio");
+        }
+        Instant::now()
+    });
+
+    let mut cursor = String::new();
+    let mut first_typed = None;
+    let mut last_typed = Instant::now();
+    let mut ended = None;
+    while let Some(event) = handle.events.recv().await {
+        let at = started.elapsed().as_secs_f64();
+        match &event {
+            StreamingEvent::Partial { text, .. } | StreamingEvent::Final { text, .. } => {
+                cursor.push_str(text);
+                first_typed.get_or_insert(at);
+                last_typed = Instant::now();
+                println!("[{at:7.3}s] type    {text:?}");
+            }
+            StreamingEvent::Replace {
+                backspace, text, ..
+            } => {
+                for _ in 0..*backspace {
+                    cursor.pop();
+                }
+                cursor.push_str(text);
+                last_typed = Instant::now();
+                println!("[{at:7.3}s] replace -{backspace} {text:?}");
+            }
+            StreamingEvent::Preview { text } => println!("[{at:7.3}s] preview {text:?}"),
+            StreamingEvent::Error(error) => println!("[{at:7.3}s] ERROR   {error}"),
+            StreamingEvent::Ended => {
+                ended = Some(at);
+                println!("[{at:7.3}s] ended");
+                break;
+            }
+        }
+    }
+    let last_audio = feeder.await.expect("feeder");
+    handle.task.await.expect("join").expect("result");
+
+    let audio_secs = last_audio.duration_since(started).as_secs_f64();
+    println!("typed text: {cursor:?}");
+    println!(
+        "first audio sample to first typed word: {:.3}s",
+        first_typed.expect("something was typed")
+    );
+    println!(
+        "last audio sample ({audio_secs:.3}s) to last typing: {:.3}s",
+        last_typed.duration_since(last_audio).as_secs_f64()
+    );
+    println!(
+        "last audio sample to Ended: {:.3}s",
+        ended.expect("stream ended") - audio_secs
+    );
+}
