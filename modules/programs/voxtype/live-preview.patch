+        let dir = tempfile::tempdir().expect("tempdir");
+        let system = dir.path().join("system.txt");
+        let user = dir.path().join("user.txt");
+        std::fs::write(&system, "Nextcloud\nnext cloud => Nextcloud\n").expect("write system");
+        std::fs::write(&user, "next cloud => NextCloud\n").expect("write user");
+        let paths = [
+            system.display().to_string(),
+            dir.path().join("missing.txt").display().to_string(),
+            user.display().to_string(),
+        ];
+        let vocabulary = Vocabulary::load(&paths, None);
+        assert_eq!(vocabulary.corrections()[0].to, "NextCloud");
+        assert_eq!(vocabulary.boosted(), ["Nextcloud", "NextCloud"]);
+    }
+
+    #[test]
+    fn load_reads_files_fresh_on_every_call() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let file = dir.path().join("vocabulary.txt");
+        let paths = [file.display().to_string()];
+        assert!(Vocabulary::load(&paths, None).boosted().is_empty());
+        std::fs::write(&file, "Tailscale\n").expect("write");
+        assert_eq!(Vocabulary::load(&paths, None).boosted(), ["Tailscale"]);
+    }
