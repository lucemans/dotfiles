+//! End-to-end tests against an in-process mock of the NeMo-Speech WebSocket.
+//! Nothing here touches the network beyond loopback.
+
+use std::future::Future;
+use std::io::{Read, Write};
+use std::net::TcpListener as StdListener;
+use std::time::Duration;
+
+use futures_util::{SinkExt, StreamExt};
+use serde_json::{json, Value};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::task::JoinHandle;
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::WebSocketStream;
+
+use super::*;
+use crate::config::WhisperMode;
+
+type Ws = WebSocketStream<TcpStream>;
+
+/// What the mock saw from the client.
+#[derive(Debug, Default)]
+struct Received {
+    update: Option<Value>,
+    audio_bytes: usize,
+}
+
+/// Listen on loopback and run `script` against the first connection.
+async fn serve<F, Fut>(script: F) -> (String, JoinHandle<Received>)
+where
+    F: FnOnce(Ws) -> Fut + Send + 'static,
+    Fut: Future<Output = Received> + Send,
+{
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let endpoint = format!("http://{}", listener.local_addr().expect("addr"));
+    let task = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.expect("accept");
+        let ws = tokio_tungstenite::accept_async(stream)
+            .await
+            .expect("handshake");
+        script(ws).await
+    });
+    (endpoint, task)
+}
+
+async fn say(ws: &mut Ws, event: Value) {
+    ws.send(Message::Text(event.to_string()))
+        .await
+        .expect("send");
+}
+
+fn delta(text: &str) -> Value {
+    json!({"type": "conversation.item.input_audio_transcription.delta", "delta": text})
+}
+
+fn completed(text: &str) -> Value {
+    json!({"type": "conversation.item.input_audio_transcription.completed", "transcript": text})
+}
+
+fn committed() -> Value {
+    json!({"type": "input_audio_buffer.committed"})
+}
+
+/// Read client frames until the commit, recording the session update and audio size.
+async fn until_commit(ws: &mut Ws, received: &mut Received) {
+    while let Some(Ok(message)) = ws.next().await {
+        match message {
+            Message::Binary(bytes) => received.audio_bytes += bytes.len(),
+            Message::Text(text) => {
+                let value: Value = serde_json::from_str(&text).expect("client json");
+                match value["type"].as_str() {
+                    Some("session.update") => received.update = Some(value),
+                    Some("input_audio_buffer.commit") => return,
+                    other => panic!("unexpected client message {other:?}"),
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+/// Wait for the first audio frame, so deltas follow audio like a real server's.
+async fn until_audio(ws: &mut Ws, received: &mut Received) {
+    while let Some(Ok(message)) = ws.next().await {
+        match message {
+            Message::Binary(bytes) => {
+                received.audio_bytes += bytes.len();
+                return;
+            }
+            Message::Text(text) => {
+                let value: Value = serde_json::from_str(&text).expect("client json");
+                if value["type"] == "session.update" {
+                    received.update = Some(value);
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+fn config_for(endpoint: &str) -> Config {
+    let mut config = Config::default();
+    config.whisper.mode = Some(WhisperMode::Remote);
+    config.whisper.remote_endpoint = Some(endpoint.to_string());
+    config.whisper.remote_realtime = true;
+    config.text.filter_filler_words = false;
+    config
+}
+
+fn vocabulary_file(text: &str) -> (tempfile::TempDir, String) {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let path = dir.path().join("vocabulary.txt");
+    std::fs::write(&path, text).expect("write vocabulary");
+    let path = path.display().to_string();
+    (dir, path)
+}
+
+/// Stream one second of audio in 10 chunks, end the recording, collect every event.
+async fn record(config: &Config) -> Vec<StreamingEvent> {
+    let transcriber = RealtimeTranscriber::new(config).expect("transcriber");
+    let (tx, rx) = mpsc::channel(64);
+    let handle = transcriber
+        .as_streaming()
+        .expect("streaming")
+        .start_stream(rx)
+        .expect("start");
+    for _ in 0..10 {
+        tx.send(vec![0.1; 1600]).await.expect("audio");
+    }
+    drop(tx);
+    collect(handle).await
+}
+
+async fn collect(mut handle: StreamHandle) -> Vec<StreamingEvent> {
+    let mut events = Vec::new();
+    while let Some(event) = tokio::time::timeout(Duration::from_secs(10), handle.events.recv())
+        .await
+        .expect("events arrive")
+    {
+        let ended = matches!(event, StreamingEvent::Ended);
+        events.push(event);
+        if ended {
+            break;
+        }
+    }
+    handle.task.await.expect("join").expect("task result");
+    events
+}
+
+/// Text at the cursor after the daemon applies the typing events in order.
+fn typed(events: &[StreamingEvent]) -> String {
+    let mut cursor = String::new();
+    for event in events {
+        match event {
+            StreamingEvent::Partial { text, .. } | StreamingEvent::Final { text, .. } => {
+                cursor.push_str(text);
+            }
+            StreamingEvent::Replace {
+                backspace, text, ..
+            } => {
+                for _ in 0..*backspace {
+                    cursor.pop();
+                }
+                cursor.push_str(text);
+            }
+            _ => {}
+        }
+    }
+    cursor
+}
+
+fn previews(events: &[StreamingEvent]) -> Vec<&str> {
+    events
+        .iter()
+        .filter_map(|event| match event {
+            StreamingEvent::Preview { text } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect()
+}
+
+#[tokio::test]
+async fn streams_words_while_audio_arrives_and_appends_the_final_tail() {
+    let (endpoint, server) = serve(|mut ws| async move {
+        let mut received = Received::default();
+        until_audio(&mut ws, &mut received).await;
+        say(&mut ws, delta("Hello")).await;
+        say(&mut ws, delta(" wor")).await;
+        say(&mut ws, delta("ld this")).await;
+        until_commit(&mut ws, &mut received).await;
+        say(&mut ws, completed("Hello world this is it.")).await;
+        say(&mut ws, committed()).await;
+        received
+    })
+    .await;
+
+    let events = record(&config_for(&endpoint)).await;
+
+    assert_eq!(typed(&events), "Hello world this is it.");
+    assert!(matches!(events.last(), Some(StreamingEvent::Ended)));
+    assert!(
+        events
+            .iter()
+            .any(|e| matches!(e, StreamingEvent::Partial { text, .. } if text == "Hello")),
+        "words are typed before the commit: {events:?}"
+    );
+    assert!(
+        events
+            .iter()
+            .any(|e| matches!(e, StreamingEvent::Final { text, .. } if text == " this is it.")),
+        "missing tail arrives as the final: {events:?}"
+    );
+    assert!(!events
+        .iter()
+        .any(|e| matches!(e, StreamingEvent::Replace { .. })));
+    assert_eq!(
+        previews(&events).last().copied(),
+        Some("Hello world this is it.")
+    );
+
+    let received = server.await.expect("server");
+    assert_eq!(received.audio_bytes, 10 * 1600 * 2);
+    let update = received.update.expect("session.update sent before audio");
+    assert_eq!(update["session"]["sample_rate"], 16_000);
+    assert!(update["session"].get("speech_contexts").is_none());
