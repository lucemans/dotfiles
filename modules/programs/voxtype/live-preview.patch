+use super::*;
+use crate::config::TextConfig;
+
+fn processor(
+    replacements: &[(&str, &str)],
+    spoken_punctuation: bool,
+    fillers: bool,
+) -> TextProcessor {
+    let config = TextConfig {
+        spoken_punctuation,
+        replacements: replacements
+            .iter()
+            .map(|(from, to)| ((*from).to_string(), (*to).to_string()))
+            .collect(),
+        filter_filler_words: fillers,
+        ..TextConfig::default()
+    };
+    TextProcessor::new(&config)
+}
+
+fn live(replacements: &[(&str, &str)]) -> LiveText {
+    LiveText::new(processor(replacements, false, false))
+}
+
+fn words(text: &str) -> Vec<String> {
+    text.split_whitespace().map(str::to_owned).collect()
+}
+
+/// Feed successive hypotheses and join what was typed, as the cursor would see it.
+fn type_all(live: &mut LiveText, hypotheses: &[&str]) -> String {
+    hypotheses
+        .iter()
+        .filter_map(|hypothesis| live.hypothesis(hypothesis).typed)
+        .collect()
+}
+
+#[test]
+fn gate_never_releases_the_unfinished_last_word() {
+    let gate = Gate::new([]);
+    assert_eq!(gate.releasable(&words("hello wor"), 0, false), 1);
+    assert_eq!(gate.releasable(&words("hello"), 0, false), 0);
+    assert_eq!(gate.releasable(&[], 0, false), 0);
+}
+
+#[test]
+fn gate_holds_a_word_that_starts_a_phrase_key() {
+    let gate = Gate::new(["next cloud"]);
+    // `next` is complete but `cloud` has not started, so the phrase is open.
+    assert_eq!(gate.releasable(&words("I use next cl"), 0, false), 2);
+    // The phrase is complete, so nothing is open any more.
+    assert_eq!(gate.releasable(&words("I use next cloud is"), 0, false), 4);
+    // `next` was followed by something else.
+    assert_eq!(gate.releasable(&words("I use next door is"), 0, false), 4);
+}
+
+#[test]
+fn gate_holds_up_to_key_length_minus_one_words() {
+    let gate = Gate::new(["one two three four"]);
+    assert_eq!(gate.releasable(&words("x one two three"), 0, false), 1);
