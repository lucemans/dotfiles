+//! Optional, private runtime-file handoff of tentative text to the GTK OSD.
+
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::PathBuf;
+
+/// Bound the preview to the most recent text while leaving committed output intact.
+const PREVIEW_CHARS: usize = 400;
+
+fn path() -> Option<PathBuf> {
+    std::env::var_os("VOXTYPE_PREVIEW_FILE").map(PathBuf::from)
+}
+
+/// Publish a hypothesis atomically so GTK never reads a partly written update.
+pub fn publish(text: &str) {
+    let Some(path) = path() else { return };
+    let temporary = path.with_extension("tmp");
+    let text: String = text
+        .chars()
+        .rev()
+        .take(PREVIEW_CHARS)
+        .collect::<Vec<_>>()
+        .into_iter()
+        .rev()
+        .collect();
+    let result = (|| -> std::io::Result<()> {
+        let mut file = std::fs::OpenOptions::new()
+            .create(true)
+            .truncate(true)
+            .write(true)
+            .mode(0o600)
+            .open(&temporary)?;
+        file.write_all(text.as_bytes())?;
+        std::fs::rename(&temporary, &path)
+    })();
+    if let Err(error) = result {
+        tracing::debug!(%error, "Cannot update dictation preview");
+    }
+}
+
+/// Read the current hypothesis without interpreting recognized text as markup.
+pub fn read() -> Option<String> {
+    std::fs::read_to_string(path()?).ok()
+}
+
+/// Remove text at recording boundaries so the next recording starts empty.
+pub fn clear() {
+    if let Some(path) = path() {
+        let _ = std::fs::remove_file(path);
+    }
+}
