+//! Vocabulary files for the realtime backend.
+//!
+//! One entry per line, UTF-8. A line that starts with `#` is a comment and
+//! blank lines are ignored:
+//!
+//! ```text
+//! Nextcloud                # not a comment: only whole lines can be comments
+//! next cloud => Nextcloud
+//! ```
+//!
+//! `Nextcloud` is a boosted term. `next cloud => Nextcloud` is a correction:
+//! whole-word, case-insensitive replacement of the recognized text, and the
+//! right-hand side is boosted too. A later entry for the same left-hand side
+//! replaces an earlier one, which is how a user file overrides the system file.
+
+use std::path::{Path, PathBuf};
+
+use serde_json::{json, Value};
+
+/// Highest boost the cache-aware RNNT decoder honors. The server clamps a
+/// request score to `asr.decoder.boosting_max_boost`, default 5.0
+/// (docs/asr/configuration.md#word-boosting), so a larger score does nothing.
+pub const MAX_BOOST: f32 = 5.0;
+
+/// Most phrases sent in one session. docs/asr/configuration.md states no
+/// phrase limit for the RNNT decoder; 256 is the cap NeMo-Speech applies to
+/// boosted words in its Flashlight decoder (`kMaxBoostWords`), kept here so a
+/// runaway vocabulary file cannot bloat session setup on any decoder.
+pub const MAX_PHRASES: usize = 256;
+
+/// A whole-word, case-insensitive replacement applied to recognized text.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Correction {
+    pub from: String,
+    pub to: String,
+}
+
+/// Terms to boost and corrections to apply, merged from vocabulary files.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Vocabulary {
+    terms: Vec<String>,
+    corrections: Vec<Correction>,
+}
+
+impl Vocabulary {
+    /// Parse one vocabulary file's contents. Unusable lines are skipped with a
+    /// warning that names the line.
+    pub fn parse(text: &str) -> Self {
+        let mut vocabulary = Self::default();
+        for (index, raw) in text.lines().enumerate() {
+            let line = raw.trim();
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            match line.split_once("=>") {
+                None => vocabulary.add_term(line),
+                Some((from, to)) => {
+                    let (from, to) = (from.trim(), to.trim());
+                    if from.is_empty() || to.is_empty() {
+                        tracing::warn!(
+                            line.number = index + 1,
+                            "Skipping vocabulary correction with an empty side"
+                        );
+                        continue;
+                    }
+                    vocabulary.add_correction(from, to);
+                }
+            }
+        }
+        vocabulary
+    }
+
+    /// Read and merge vocabulary files in order; later files win. A file that
+    /// does not exist is skipped silently, one that cannot be read is skipped
+    /// with a warning. A leading `~` in a path expands to `home`.
+    pub fn load(paths: &[String], home: Option<&Path>) -> Self {
+        let mut merged = Self::default();
+        for configured in paths {
+            let path = expand_home(configured, home);
+            match std::fs::read_to_string(&path) {
+                Ok(text) => merged.merge(Self::parse(&text)),
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                Err(error) => tracing::warn!(
+                    file.path = %path.display(),
+                    %error,
+                    "Cannot read vocabulary file"
+                ),
+            }
+        }
+        merged
+    }
+
+    /// Fold `later` into `self`: its terms are appended and its corrections
+    /// replace corrections with the same left-hand side.
+    pub fn merge(&mut self, later: Self) {
+        for term in later.terms {
+            self.add_term(&term);
+        }
+        for correction in later.corrections {
+            self.add_correction(&correction.from, &correction.to);
+        }
+    }
+
+    pub fn corrections(&self) -> &[Correction] {
+        &self.corrections
+    }
+
+    /// Every phrase worth boosting: the plain terms, then each correction's
+    /// right-hand side, without duplicates.
+    pub fn boosted(&self) -> Vec<&str> {
+        let mut phrases: Vec<&str> = Vec::with_capacity(self.terms.len() + self.corrections.len());
+        let wanted = self
+            .terms
+            .iter()
+            .map(String::as_str)
+            .chain(self.corrections.iter().map(|c| c.to.as_str()));
+        for phrase in wanted {
+            if !phrases.contains(&phrase) {
+                phrases.push(phrase);
+            }
+        }
+        phrases
+    }
+
+    /// The `speech_contexts` value for a session, or `None` when there is
+    /// nothing to send. The score is clamped to [`MAX_BOOST`] and the phrase
+    /// list to [`MAX_PHRASES`]; both log when they bite.
+    pub fn speech_contexts(&self, boost: f32) -> Option<Value> {
+        if boost <= 0.0 || boost.is_nan() {
+            return None;
+        }
+        let mut phrases = self.boosted();
+        if phrases.is_empty() {
+            return None;
+        }
+        let boost = if boost > MAX_BOOST {
+            tracing::warn!(
+                boost.configured = boost,
+                boost.sent = MAX_BOOST,
+                "remote_boost is above what the server honors; clamping"
+            );
+            MAX_BOOST
+        } else {
+            boost
+        };
+        if phrases.len() > MAX_PHRASES {
+            tracing::warn!(
+                phrases.total = phrases.len(),
+                phrases.sent = MAX_PHRASES,
+                "Vocabulary has more boosted phrases than one session takes; truncating"
+            );
+            phrases.truncate(MAX_PHRASES);
+        }
+        // Three decimals keep an f32 like 2.7 from serializing as 2.700000047...
+        let boost = (f64::from(boost) * 1000.0).round() / 1000.0;
+        Some(json!([{ "phrases": phrases, "boost": boost }]))
+    }
+
+    fn add_term(&mut self, term: &str) {
+        if !self.terms.iter().any(|known| known == term) {
+            self.terms.push(term.to_string());
+        }
+    }
+
+    fn add_correction(&mut self, from: &str, to: &str) {
+        let key = from.to_lowercase();
+        let correction = Correction {
+            from: from.to_string(),
+            to: to.to_string(),
+        };
+        match self
+            .corrections
+            .iter_mut()
+            .find(|known| known.from.to_lowercase() == key)
+        {
+            Some(known) => *known = correction,
+            None => self.corrections.push(correction),
+        }
+    }
+}
+
+/// Expand a leading `~` or `~/` to `home`. Any other path is returned as is,
+/// and so is a `~` path when `home` is unknown.
+pub fn expand_home(path: &str, home: Option<&Path>) -> PathBuf {
+    let Some(home) = home else {
+        return PathBuf::from(path);
+    };
+    if path == "~" {
+        return home.to_path_buf();
+    }
+    match path.strip_prefix("~/") {
+        Some(rest) => home.join(rest),
+        None => PathBuf::from(path),
+    }
+}
