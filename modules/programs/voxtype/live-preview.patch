+//! Turns the server's running hypothesis into text typed at the cursor.
+//!
+//! Typed text cannot be edited without backspaces, so a word is typed only
+//! once nothing the server can still say will change what it should look like.
+//! This module holds that policy and has no sockets in it.
+//!
+//! # Hold-back policy
+//!
+//! For the current utterance's hypothesis, a word is released (typed) when
+//! all of these hold:
+//!
+//! 1. It is not the last word. The last word is still being spelled.
+//! 2. No run of complete words that ends the hypothesis and starts at this
+//!    word (or earlier) is a proper prefix of a multi-word phrase key. Keys are
+//!    the replacement keys from `[text]` and the vocabulary files, plus the
+//!    spoken punctuation phrases when `spoken_punctuation` is on. With key
+//!    `next cloud`, the words `... next` are held until the next word shows
+//!    whether the phrase completes.
+//! 3. Its text has not been revised (see [`LiveText::hypothesis`]).
+//!
+//! At the end of an utterance everything is released. Released words go
+//! through the same filler, replacement and spoken punctuation processing as
+//! batch output ([`TextProcessor::process_fragment`]).
+//!
+//! When the server's final transcript for the utterance arrives,
+//! [`LiveText::end_utterance`] compares it with what was typed. Words that
+//! agree up to case and edge punctuation stay as typed. A genuine difference
+//! becomes a backspace and a retype from the first typing action that
+//! contained a differing word.
+
+use crate::text::TextProcessor;
+
+/// Characters of typed text kept for the overlay preview. The overlay shows
+/// the last few hundred characters, so older text is dropped.
+const RECENT_CHARS: usize = 512;
+
+/// Punctuation that attaches to the word before it (spoken punctuation output).
+const GLUE_LEFT: &[char] = &[
+    '.', ',', '?', '!', ':', ';', ')', ']', '}', '(', '[', '{', '#', '@', '$',
+];
+
+/// Punctuation that attaches to the word after it.
+const GLUE_RIGHT: &[char] = &['(', '[', '{', '#', '@', '$'];
+
+/// Decides how many leading words of a hypothesis may be typed.
+#[derive(Debug, Clone, Default)]
+pub struct Gate {
+    keys: Vec<Vec<String>>,
+}
+
+impl Gate {
+    /// Build a gate from phrase keys. Single-word keys never need hold-back
+    /// beyond the unfinished last word, so they are dropped.
+    pub fn new<'a>(phrases: impl IntoIterator<Item = &'a str>) -> Self {
+        let keys = phrases
+            .into_iter()
+            .map(|phrase| phrase.split_whitespace().map(normalize).collect::<Vec<_>>())
+            .filter(|key| key.len() > 1)
+            .collect();
+        Self { keys }
+    }
+
+    /// Number of leading words of `words` that can be released. Never less
+    /// than `from`, the count already typed. With `ended` the hypothesis is
+    /// complete and every word is released.
+    pub fn releasable(&self, words: &[String], from: usize, ended: bool) -> usize {
+        if ended {
+            return words.len();
+        }
+        let complete = words.len().saturating_sub(1);
+        for start in from..complete {
+            let tail = &words[start..complete];
+            let could_complete = self.keys.iter().any(|key| {
+                key.len() > tail.len()
+                    && tail
+                        .iter()
+                        .zip(key)
+                        .all(|(word, wanted)| normalize(word) == *wanted)
+            });
+            if could_complete {
+                return start;
+            }
+        }
+        complete.max(from)
+    }
+}
+
+/// A backspace-and-retype that brings typed text in line with the final transcript.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Fix {
+    /// Characters to erase from the end of the typed text; 0 for a pure append.
+    pub backspace: usize,
+    pub text: String,
+}
+
+/// What one hypothesis update produced.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Update {
+    /// Text to type now, including its separator.
+    pub typed: Option<String>,
+    /// Everything typed this session plus the held-back words, for the overlay.
+    pub preview: String,
+}
+
+/// Where the cursor stands: what the next piece has to join onto.
+#[derive(Debug, Clone, Copy, Default)]
+struct Cursor {
+    last: Option<char>,
+    /// The last word is a bare opening symbol, so the next piece attaches without a space.
+    glue: bool,
+}
+
+impl Cursor {
+    fn after(self, typed: &str) -> Self {
+        let Some(last) = typed.chars().last() else {
+            return self;
+        };
+        let last_word = typed.split_whitespace().next_back().unwrap_or("");
+        Self {
+            last: Some(last),
+            glue: GLUE_RIGHT.contains(&last) && !has_alphanumeric(last_word),
+        }
+    }
+
+    /// `piece` with the separator that joins it to what is already typed.
+    /// `raw` is the recognized text `piece` was made from. Punctuation that
+    /// processing produced (spoken "period") attaches to the word before it;
+    /// punctuation the server typed itself (".NET", "(maybe)") keeps its space.
+    fn join(self, raw: &str, piece: &str) -> String {
+        let Some(first) = piece.chars().next() else {
+            return String::new();
+        };
+        let generated = GLUE_LEFT.contains(&first) && !raw.starts_with(first);
+        let glues_left = first.is_whitespace() || generated;
+        let after_word = self.last.is_some_and(|c| !c.is_whitespace()) && !self.glue;
+        if after_word && !glues_left {
+            format!(" {piece}")
+        } else {
+            piece.to_string()
+        }
+    }
+}
+
+/// One typing action: the words it covered and how to undo it.
+#[derive(Debug, Clone, Copy)]
+struct Typing {
+    /// Words of the utterance typed up to and including this action.
+    words_end: usize,
+    chars: usize,
+    before: Cursor,
+}
+
+/// Incremental typed output for one recording.
+pub struct LiveText {
+    processor: TextProcessor,
+    gate: Gate,
+    /// Words of the current utterance's latest hypothesis.
+    words: Vec<String>,
+    /// Words of this utterance already typed, as they were when typed.
+    typed: Vec<String>,
+    log: Vec<Typing>,
+    cursor: Cursor,
+    /// Tail of everything typed this session.
+    recent: String,
+    recent_before: String,
+    cursor_before: Cursor,
+}
+
+impl LiveText {
+    pub fn new(processor: TextProcessor) -> Self {
+        let gate = Gate::new(processor.phrase_keys());
+        Self {
+            processor,
+            gate,
+            words: Vec::new(),
+            typed: Vec::new(),
+            log: Vec::new(),
+            cursor: Cursor::default(),
+            recent: String::new(),
+            recent_before: String::new(),
+            cursor_before: Cursor::default(),
+        }
+    }
+
+    /// Feed the full text of the current utterance so far.
+    ///
+    /// If the server revised a word that is already typed, nothing more is
+    /// typed for this utterance until its final transcript arrives: the
+    /// overlay shows the revised text and [`end_utterance`](Self::end_utterance)
+    /// repairs the cursor.
+    pub fn hypothesis(&mut self, text: &str) -> Update {
+        self.words = text.split_whitespace().map(str::to_owned).collect();
+        let diverged = self.diverged();
+        let mut typed = None;
+        if !diverged {
+            let release = self.gate.releasable(&self.words, self.typed.len(), false);
+            if release > self.typed.len() {
+                typed = self.type_through(release);
+            }
+        }
+        Update {
+            typed,
+            preview: self.preview(diverged),
+        }
+    }
+
+    /// The utterance is over and `final_text` is the server's last word on it.
+    /// Returns the text to type or repair, and resets for the next utterance.
+    pub fn end_utterance(&mut self, final_text: &str) -> Option<Fix> {
+        let final_words: Vec<String> = final_text.split_whitespace().map(str::to_owned).collect();
+        let agreed = self
+            .typed
+            .iter()
+            .zip(&final_words)
+            .take_while(|(typed, wanted)| same_word(typed, wanted))
+            .count();
+        let fix = if agreed == self.typed.len() {
+            self.append_tail(&final_words)
+        } else {
+            self.retype_from(agreed, &final_words)
+        };
+        self.words.clear();
+        self.typed.clear();
+        self.log.clear();
+        self.recent_before.clone_from(&self.recent);
+        self.cursor_before = self.cursor;
+        fix
+    }
+
+    /// End the utterance with the latest hypothesis standing in for a final
+    /// transcript, releasing every held-back word.
+    pub fn end_with_hypothesis(&mut self) -> Option<Fix> {
+        let text = self.words.join(" ");
+        self.end_utterance(&text)
+    }
+
+    /// True when the current utterance has no words, typed or held back.
+    pub fn is_empty(&self) -> bool {
+        self.words.is_empty() && self.typed.is_empty()
+    }
+
+    /// Everything typed this session plus the held-back words.
+    pub fn current_preview(&self) -> String {
+        self.preview(self.diverged())
+    }
+
+    fn diverged(&self) -> bool {
+        self.words.len() < self.typed.len()
+            || self
+                .typed
+                .iter()
+                .zip(&self.words)
+                .any(|(typed, now)| !same_word(typed, now))
+    }
+
+    fn preview(&self, diverged: bool) -> String {
+        let (base, cursor, held) = if diverged {
+            (&self.recent_before, self.cursor_before, &self.words[..])
+        } else {
+            (&self.recent, self.cursor, &self.words[self.typed.len()..])
+        };
+        format!("{base}{}", self.render(cursor, held))
+    }
+
+    /// `words` processed like batch output and joined onto `cursor`.
+    fn render(&self, cursor: Cursor, words: &[String]) -> String {
+        let raw = words.join(" ");
+        cursor.join(&raw, &self.processor.process_fragment(&raw))
+    }
+
+    /// Type `words[typed..upto]` as one action.
+    fn type_through(&mut self, upto: usize) -> Option<String> {
+        let from = self.typed.len();
+        let text = self.render(self.cursor, &self.words[from..upto]);
+        self.log.push(Typing {
+            words_end: upto,
+            chars: text.chars().count(),
+            before: self.cursor,
+        });
+        self.typed.extend_from_slice(&self.words[from..upto]);
+        if text.is_empty() {
+            return None;
+        }
+        self.cursor = self.cursor.after(&text);
+        self.push_recent(&text);
+        Some(text)
+    }
+
+    fn append_tail(&mut self, final_words: &[String]) -> Option<Fix> {
+        let text = self.render(self.cursor, &final_words[self.typed.len()..]);
+        if text.is_empty() {
+            return None;
+        }
+        self.cursor = self.cursor.after(&text);
+        self.push_recent(&text);
+        Some(Fix { backspace: 0, text })
+    }
+
+    /// The final transcript differs from typed words from `agreed` on. Erase
+    /// back to the start of the typing action that contains word `agreed` and
+    /// type the final words from there.
+    fn retype_from(&mut self, agreed: usize, final_words: &[String]) -> Option<Fix> {
+        let first = self
+            .log
+            .iter()
+            .position(|typing| typing.words_end > agreed)
+            .expect("a differing typed word lies inside a typing action");
+        let backspace = self.log[first..].iter().map(|typing| typing.chars).sum();
+        let start = first
+            .checked_sub(1)
+            .map_or(0, |previous| self.log[previous].words_end);
+        let before = self.log[first].before;
+        let text = self.render(before, &final_words[start..]);
+        for _ in 0..backspace {
+            self.recent.pop();
+        }
+        self.cursor = before.after(&text);
+        self.push_recent(&text);
+        (backspace > 0 || !text.is_empty()).then_some(Fix { backspace, text })
+    }
+
+    fn push_recent(&mut self, text: &str) {
+        self.recent.push_str(text);
+        let length = self.recent.chars().count();
+        if length > 2 * RECENT_CHARS {
+            let cut = self
+                .recent
+                .char_indices()
+                .nth(length - RECENT_CHARS)
+                .map_or(0, |(index, _)| index);
+            self.recent.drain(..cut);
+        }
+    }
+}
+
+fn has_alphanumeric(word: &str) -> bool {
+    word.chars().any(char::is_alphanumeric)
+}
+
+/// Lowercase with edge punctuation removed, the form words are compared in.
+fn normalize(word: &str) -> String {
+    word.trim_matches(|c: char| !c.is_alphanumeric())
+        .to_lowercase()
+}
+
+fn same_word(a: &str, b: &str) -> bool {
+    normalize(a) == normalize(b)
+}
