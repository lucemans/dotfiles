+//! One recording's WebSocket conversation with the server.
+
+use std::time::Duration;
+
+use futures_util::{Sink, SinkExt, StreamExt};
+use tokio::sync::{mpsc, oneshot};
+use tokio::time::Instant;
+use tokio_tungstenite::tungstenite::client::IntoClientRequest;
+use tokio_tungstenite::tungstenite::http::header::{HeaderValue, AUTHORIZATION};
+use tokio_tungstenite::tungstenite::{Error as SocketError, Message};
+use tokio_tungstenite::{MaybeTlsStream, WebSocketStream};
+
+use super::protocol::{self, Hypothesis, ServerEvent};
+use super::stream_text::{Fix, LiveText, Update};
+use crate::error::TranscribeError;
+use crate::transcribe::streaming::{SegmentId, StreamingEvent};
+
+/// Longest wait for the TCP and WebSocket handshake. Audio keeps queueing
+/// while it runs, but the daemon's capture queue holds only about a second, so
+/// a server that has not answered in ten seconds has lost the start of the
+/// recording anyway.
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// Longest wait, after the commit, for the final transcript. The server
+/// first finishes audio it has queued, which on a CPU server that runs slower
+/// than real time can take a while; its own socket timeout is 30 s
+/// (`--read-timeout`), so waiting longer than that cannot help.
+const FINAL_TIMEOUT: Duration = Duration::from_secs(20);
+
+type Socket = WebSocketStream<MaybeTlsStream<tokio::net::TcpStream>>;
+
+/// Everything one recording needs, resolved when the recording starts.
+pub struct Session {
+    pub url: String,
+    pub api_key: Option<String>,
+    /// The `session.update` message, with this recording's vocabulary.
+    pub update: String,
+    pub live: LiveText,
+}
+
+/// Why the conversation stopped early.
+enum Stop {
+    /// The daemon dropped the event receiver; there is nobody to tell.
+    ReceiverGone,
+    Failed(TranscribeError),
+}
+
+impl From<TranscribeError> for Stop {
+    fn from(error: TranscribeError) -> Self {
+        Self::Failed(error)
+    }
+}
+
+/// Sends events to the daemon and remembers what the overlay shows.
+struct Output {
+    events: mpsc::Sender<StreamingEvent>,
+    segment: SegmentId,
+    preview: String,
+}
+
+impl Output {
+    async fn send(&self, event: StreamingEvent) -> Result<(), Stop> {
+        self.events
+            .send(event)
+            .await
+            .map_err(|_| Stop::ReceiverGone)
+    }
+
+    /// Type new words and refresh the overlay.
+    async fn update(&mut self, update: Update) -> Result<(), Stop> {
+        if let Some(text) = update.typed {
+            self.send(StreamingEvent::Partial {
+                text,
+                segment_id: self.segment,
+            })
+            .await?;
+        }
+        self.show(update.preview);
+        Ok(())
+    }
+
+    /// Append the tail of a final transcript, or erase and retype where it
+    /// disagrees with what was typed.
+    async fn fix(&mut self, fix: Option<Fix>, preview: String) -> Result<(), Stop> {
+        let segment_id = self.segment;
+        match fix {
+            Some(Fix { backspace: 0, text }) => {
+                self.send(StreamingEvent::Final { text, segment_id })
+                    .await?;
+            }
+            Some(Fix { backspace, text }) => {
+                self.send(StreamingEvent::Replace {
+                    backspace,
+                    text,
+                    segment_id,
+                })
+                .await?;
+            }
+            None => {}
+        }
+        self.show(preview);
+        Ok(())
+    }
+
+    /// The overlay is best effort: a full queue drops the refresh, and the
+    /// next one carries the same text and more.
+    fn show(&mut self, preview: String) {
+        if preview != self.preview {
+            let _ = self.events.try_send(StreamingEvent::Preview {
+                text: preview.clone(),
+            });
+            self.preview = preview;
+        }
+    }
+}
+
+/// Run one recording to its end. Always finishes with `Ended`, after an
+/// `Error` when the conversation failed.
+pub async fn run(
+    session: Session,
+    samples_rx: mpsc::Receiver<Vec<f32>>,
+    events: mpsc::Sender<StreamingEvent>,
+    cancel_rx: oneshot::Receiver<()>,
+) {
+    let mut output = Output {
+        events,
+        segment: 0,
+        preview: String::new(),
+    };
+    match converse(session, samples_rx, &mut output, cancel_rx).await {
+        Ok(()) => {}
+        Err(Stop::ReceiverGone) => return,
+        Err(Stop::Failed(error)) => {
+            if output.send(StreamingEvent::Error(error)).await.is_err() {
+                return;
+            }
+        }
+    }
+    let _ = output.send(StreamingEvent::Ended).await;
+}
+
+async fn converse(
+    mut session: Session,
+    mut samples_rx: mpsc::Receiver<Vec<f32>>,
+    output: &mut Output,
+    mut cancel_rx: oneshot::Receiver<()>,
+) -> Result<(), Stop> {
+    let started = Instant::now();
+
+    // Audio queues while the handshake runs and is replayed once connected.
+    let mut queued: Vec<Vec<f32>> = Vec::new();
+    let mut audio_open = true;
+    let socket = {
+        let handshake = connect(&session.url, session.api_key.as_deref());
+        tokio::pin!(handshake);
+        loop {
+            tokio::select! {
+                biased;
+                _ = &mut cancel_rx => return Ok(()),
+                socket = &mut handshake => break socket?,
+                chunk = samples_rx.recv(), if audio_open => match chunk {
+                    Some(chunk) => queued.push(chunk),
+                    None => audio_open = false,
+                },
+            }
+        }
+    };
+    tracing::debug!(
+        elapsed.ms = started.elapsed().as_millis() as u64,
+        "Realtime session connected"
+    );
+    let (mut write, mut read) = socket.split();
+
+    write
+        .send(Message::Text(session.update.clone()))
+        .await
+        .map_err(network)?;
+    for chunk in queued {
+        send_audio(&mut write, &chunk).await?;
+    }
+
+    let mut hypothesis = Hypothesis::default();
+    let mut deadline: Option<Instant> = None;
+    let mut final_seen = false;
+    let mut first_delta = true;
+    let mut commit_sent: Option<Instant> = None;
+    if !audio_open {
+        write
+            .send(Message::Text(protocol::COMMIT.into()))
+            .await
+            .map_err(network)?;
+        deadline = Some(Instant::now() + FINAL_TIMEOUT);
+        commit_sent = Some(Instant::now());
+    }
+
+    let result: Result<(), Stop> = loop {
+        let timeout = async {
+            match deadline {
+                Some(at) => tokio::time::sleep_until(at).await,
+                None => std::future::pending().await,
+            }
+        };
+        tokio::select! {
+            biased;
+            _ = &mut cancel_rx => {
+                let _ = write.send(Message::Close(None)).await;
+                return Ok(());
+            }
+            () = timeout => {
+                break Err(Stop::Failed(TranscribeError::NetworkError(format!(
+                    "no final transcript {}s after the audio ended",
+                    FINAL_TIMEOUT.as_secs()
+                ))));
+            }
+            chunk = samples_rx.recv(), if audio_open => match chunk {
+                Some(chunk) => {
+                    if let Err(error) = send_audio(&mut write, &chunk).await {
+                        break Err(error.into());
+                    }
+                }
+                None => {
+                    audio_open = false;
+                    if let Err(error) = write.send(Message::Text(protocol::COMMIT.into())).await {
+                        break Err(network(error).into());
+                    }
+                    deadline = Some(Instant::now() + FINAL_TIMEOUT);
+                    commit_sent = Some(Instant::now());
+                    tracing::info!("Realtime: audio ended, commit sent");
+                }
+            },
+            message = read.next() => {
+                let text = match message {
+                    Some(Ok(Message::Text(text))) => text,
+                    Some(Ok(Message::Close(_))) | None => {
+                        break if final_seen {
+                            Ok(())
+                        } else {
+                            Err(Stop::Failed(TranscribeError::NetworkError(
+                                "server closed the connection before the final transcript".into(),
+                            )))
+                        };
+                    }
+                    Some(Ok(_)) => continue,
+                    Some(Err(error)) => break Err(network(error).into()),
+                };
+                let Some(event) = protocol::parse_event(&text) else { continue };
+                match event {
+                    ServerEvent::Session => {}
+                    // The server ticks once per 0.1 s of audio, most with nothing new.
+                    ServerEvent::Delta(delta) if delta.is_empty() => {}
+                    ServerEvent::Delta(delta) => {
+                        if first_delta {
+                            first_delta = false;
+                            tracing::debug!(
+                                elapsed.ms = started.elapsed().as_millis() as u64,
+                                "First partial transcript"
+                            );
+                        }
+                        let update = session.live.hypothesis(hypothesis.apply(&delta));
+                        if let Err(stop) = output.update(update).await {
+                            break Err(stop);
+                        }
+                    }
+                    ServerEvent::Completed(transcript) => {
+                        hypothesis.clear();
+                        let fix = session.live.end_utterance(&transcript);
+                        let preview = session.live.current_preview();
+                        if let Err(stop) = output.fix(fix, preview).await {
+                            break Err(stop);
+                        }
+                        output.segment += 1;
+                        final_seen = !audio_open;
+                        if let Some(sent) = commit_sent {
+                            tracing::info!(
+                                after.commit.ms = sent.elapsed().as_millis() as u64,
+                                "Realtime: final transcript received"
+                            );
+                        }
+                    }
+                    ServerEvent::Committed => {
+                        if let Some(sent) = commit_sent {
+                            tracing::info!(
+                                after.commit.ms = sent.elapsed().as_millis() as u64,
+                                "Realtime: commit confirmed"
+                            );
+                        }
+                        break Ok(());
+                    }
+                    ServerEvent::Error(message) => {
+                        break Err(Stop::Failed(TranscribeError::RemoteError(message)));
+                    }
+                }
+            }
+        }
+    };
+
+    // Whatever ended the conversation, words still held back were spoken.
+    // Type them rather than lose them, then report the failure if there was one.
+    if !session.live.is_empty() {
+        let fix = session.live.end_with_hypothesis();
+        let preview = session.live.current_preview();
+        output.fix(fix, preview).await?;
+    }
+    let _ = write.send(Message::Close(None)).await;
+    result
+}
+
+async fn connect(url: &str, api_key: Option<&str>) -> Result<Socket, TranscribeError> {
+    let mut request = url.into_client_request().map_err(|error| {
+        TranscribeError::ConfigError(format!("invalid realtime endpoint {url}: {error}"))
+    })?;
+    if let Some(key) = api_key {
+        let bearer = HeaderValue::from_str(&format!("Bearer {key}")).map_err(|error| {
+            TranscribeError::ConfigError(format!(
+                "remote_api_key is not a valid header value: {error}"
+            ))
+        })?;
+        request.headers_mut().insert(AUTHORIZATION, bearer);
+    }
+    let (socket, _) =
+        tokio::time::timeout(CONNECT_TIMEOUT, tokio_tungstenite::connect_async(request))
+            .await
+            .map_err(|_| {
+                TranscribeError::NetworkError(format!(
+                    "timed out connecting to {url} after {}s",
+                    CONNECT_TIMEOUT.as_secs()
+                ))
+            })?
+            .map_err(|error| {
+                TranscribeError::NetworkError(format!("cannot connect to {url}: {error}"))
+            })?;
+    Ok(socket)
+}
+
+async fn send_audio<S>(write: &mut S, samples: &[f32]) -> Result<(), TranscribeError>
+where
+    S: Sink<Message, Error = SocketError> + Unpin,
+{
+    if samples.is_empty() {
+        return Ok(());
+    }
+    write
+        .send(Message::Binary(protocol::pcm16_le(samples)))
+        .await
+        .map_err(network)
+}
+
+fn network(error: SocketError) -> TranscribeError {
+    TranscribeError::NetworkError(format!("realtime connection failed: {error}"))
+}
