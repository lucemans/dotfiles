+        assert_eq!(
+            expand_home("/etc/voxtype/vocabulary.txt", Some(home)),
+            PathBuf::from("/etc/voxtype/vocabulary.txt")
+        );
+        assert_eq!(
+            expand_home("~other/x", Some(home)),
+            PathBuf::from("~other/x")
+        );
+        assert_eq!(expand_home("~/x", None), PathBuf::from("~/x"));
+    }
