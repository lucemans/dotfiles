+//! Wire format of the NeMo-Speech realtime transcription WebSocket
+//! (`docs/api.md#websocket-v1audiotranscriptionsrealtime`).
+//!
+//! The server sends `session.created`, accepts one `session.update` before
+//! audio, then binary little-endian PCM16 frames, and finishes on
+//! `input_audio_buffer.commit`. It answers with
+//! `conversation.item.input_audio_transcription.delta` (partials) and
+//! `.completed` (finals), then `input_audio_buffer.committed`.
+
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+use crate::error::TranscribeError;
+
+const REALTIME_PATH: &str = "/v1/audio/transcriptions/realtime";
+
+/// The client message that ends the audio and asks for the final transcript.
+pub const COMMIT: &str = r#"{"type":"input_audio_buffer.commit"}"#;
+
+/// Sample rate voxtype captures at and the models expect.
+pub const SAMPLE_RATE: u32 = 16_000;
+
+/// `http://host:port` to `ws://host:port/v1/audio/transcriptions/realtime`,
+/// `https` to `wss`.
+pub fn websocket_url(endpoint: &str) -> Result<String, TranscribeError> {
+    let base = endpoint.trim_end_matches('/');
+    let rest = if let Some(rest) = base.strip_prefix("https://") {
+        format!("wss://{rest}")
+    } else if let Some(rest) = base.strip_prefix("http://") {
+        format!("ws://{rest}")
+    } else {
+        return Err(TranscribeError::ConfigError(format!(
+            "remote_endpoint must start with http:// or https://, got: {endpoint}"
+        )));
+    };
+    Ok(format!("{rest}{REALTIME_PATH}"))
+}
+
+/// The `session.update` message: PCM rate, punctuation, and word boosting.
+pub fn session_update(speech_contexts: Option<Value>) -> String {
+    let mut session = json!({
+        "sample_rate": SAMPLE_RATE,
+        "automatic_punctuation": true,
+    });
+    if let Some(contexts) = speech_contexts {
+        session["speech_contexts"] = contexts;
+    }
+    json!({ "type": "session.update", "session": session }).to_string()
+}
+
+/// Little-endian PCM16 for a chunk of `f32` samples in [-1, 1].
+pub fn pcm16_le(samples: &[f32]) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(samples.len() * 2);
+    for sample in samples {
+        // Truncating cast is the conversion: the clamp keeps it in i16 range.
+        let value = (sample.clamp(-1.0, 1.0) * f32::from(i16::MAX)) as i16;
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    bytes
+}
+
+/// A server event this client acts on.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ServerEvent {
+    /// `session.created` or `session.updated`.
+    Session,
+    /// `...input_audio_transcription.delta`: a partial of the current utterance.
+    Delta(String),
+    /// `...input_audio_transcription.completed`: the utterance is final.
+    Completed(String),
+    /// `input_audio_buffer.committed`: the commit was processed.
+    Committed,
+    /// `error`.
+    Error(String),
+}
+
+#[derive(Deserialize)]
+struct Wire {
+    #[serde(rename = "type")]
+    kind: String,
+    delta: Option<String>,
+    transcript: Option<String>,
+    error: Option<WireError>,
+}
+
+#[derive(Deserialize)]
+struct WireError {
+    message: Option<String>,
+}
+
+/// Parse a text frame. `None` for event types this client has no use for
+/// (`input_audio_buffer.cleared`, anything newer) and for malformed JSON.
+pub fn parse_event(text: &str) -> Option<ServerEvent> {
+    let wire: Wire = serde_json::from_str(text).ok()?;
+    match wire.kind.as_str() {
+        "session.created" | "session.updated" => Some(ServerEvent::Session),
+        "conversation.item.input_audio_transcription.delta" => {
+            Some(ServerEvent::Delta(wire.delta.unwrap_or_default()))
+        }
+        "conversation.item.input_audio_transcription.completed" => {
+            Some(ServerEvent::Completed(wire.transcript.unwrap_or_default()))
+        }
+        "input_audio_buffer.committed" => Some(ServerEvent::Committed),
+        "error" => Some(ServerEvent::Error(
+            wire.error
+                .and_then(|error| error.message)
+                .unwrap_or_else(|| text.to_string()),
+        )),
+        _ => None,
+    }
+}
+
+/// The running text of the current utterance, rebuilt from `delta` events.
+///
+/// The server sends the new suffix when the hypothesis grew, and the whole new
+/// hypothesis when it did not (`http_server.cpp`, `extends_previous`), with
+/// nothing marking which. A delta that starts a new word cannot be a whole
+/// hypothesis; a delta with no leading space that opens with the hypothesis's
+/// own first word is taken as one.
+#[derive(Debug, Default)]
+pub struct Hypothesis {
+    text: String,
+}
+
+impl Hypothesis {
+    pub fn apply(&mut self, delta: &str) -> &str {
+        if self.is_whole_hypothesis(delta) {
+            self.text.clear();
+        }
+        self.text.push_str(delta);
+        &self.text
+    }
+
+    pub fn clear(&mut self) {
+        self.text.clear();
+    }
+
+    fn is_whole_hypothesis(&self, delta: &str) -> bool {
+        let Some(first) = self.text.split_whitespace().next().map(normalized) else {
+            return false;
+        };
+        if first.is_empty() || delta.starts_with(char::is_whitespace) {
+            return false;
+        }
+        delta
+            .split_whitespace()
+            .next()
+            .is_some_and(|word| normalized(word) == first)
+    }
+}
+
+fn normalized(word: &str) -> String {
+    word.trim_matches(|c: char| !c.is_alphanumeric())
+        .to_lowercase()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn url_swaps_scheme_and_appends_the_realtime_path() {
+        assert_eq!(
+            websocket_url("http://127.0.0.1:8010").expect("url"),
+            "ws://127.0.0.1:8010/v1/audio/transcriptions/realtime"
+        );
+        assert_eq!(
+            websocket_url("https://speech.example.com/").expect("url"),
+            "wss://speech.example.com/v1/audio/transcriptions/realtime"
+        );
+        assert!(websocket_url("ftp://host").is_err());
+    }
+
+    #[test]
+    fn session_update_carries_rate_punctuation_and_contexts() {
+        let plain: Value = serde_json::from_str(&session_update(None)).expect("json");
+        assert_eq!(plain["type"], "session.update");
+        assert_eq!(plain["session"]["sample_rate"], 16_000);
+        assert_eq!(plain["session"]["automatic_punctuation"], true);
+        assert!(plain["session"].get("speech_contexts").is_none());
+
+        let contexts = json!([{ "phrases": ["Nextcloud"], "boost": 2.5 }]);
+        let boosted: Value =
+            serde_json::from_str(&session_update(Some(contexts.clone()))).expect("json");
+        assert_eq!(boosted["session"]["speech_contexts"], contexts);
+    }
+
+    #[test]
+    fn pcm16_is_little_endian_and_clamped() {
+        assert_eq!(
+            pcm16_le(&[0.0, 1.0, -1.0, 2.0]),
+            [0, 0, 0xff, 0x7f, 0x01, 0x80, 0xff, 0x7f]
+        );
+    }
+
+    #[test]
+    fn parses_the_documented_events() {
+        assert_eq!(
+            parse_event(r#"{"type":"session.created","session":{}}"#),
+            Some(ServerEvent::Session)
+        );
+        assert_eq!(
+            parse_event(
+                r#"{"type":"conversation.item.input_audio_transcription.delta","delta":" world"}"#
+            ),
+            Some(ServerEvent::Delta(" world".into()))
+        );
+        assert_eq!(
+            parse_event(
+                r#"{"type":"conversation.item.input_audio_transcription.completed","transcript":"Hello world."}"#
+            ),
+            Some(ServerEvent::Completed("Hello world.".into()))
+        );
+        assert_eq!(
+            parse_event(r#"{"type":"input_audio_buffer.committed"}"#),
+            Some(ServerEvent::Committed)
+        );
+        assert_eq!(
+            parse_event(
+                r#"{"type":"error","error":{"message":"bad rate","type":"invalid_request_error"}}"#
+            ),
+            Some(ServerEvent::Error("bad rate".into()))
+        );
+        assert_eq!(
+            parse_event(r#"{"type":"input_audio_buffer.cleared"}"#),
+            None
+        );
+        assert_eq!(parse_event("not json"), None);
+    }
+
+    #[test]
+    fn deltas_extend_the_hypothesis() {
+        let mut hypothesis = Hypothesis::default();
+        assert_eq!(hypothesis.apply("Hel"), "Hel");
+        assert_eq!(hypothesis.apply("lo"), "Hello");
+        assert_eq!(hypothesis.apply(" wor"), "Hello wor");
+        assert_eq!(hypothesis.apply("ld,"), "Hello world,");
+    }
+
+    #[test]
+    fn a_delta_that_repeats_the_first_word_replaces_the_hypothesis() {
+        let mut hypothesis = Hypothesis::default();
+        hypothesis.apply("hello wor");
+        assert_eq!(hypothesis.apply("Hello, world"), "Hello, world");
+        assert_eq!(hypothesis.apply(" again"), "Hello, world again");
+    }
+
+    #[test]
+    fn a_continuation_of_the_last_word_is_not_a_replacement() {
+        let mut hypothesis = Hypothesis::default();
+        hypothesis.apply("go");
