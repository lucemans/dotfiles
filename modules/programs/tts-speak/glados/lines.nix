# GLaDOS voice lines from theportalwiki.com, Portal and Portal 2.
# Generated data. The list order is the rofi menu order and the clip index.
[
  {
    text = "Hello and, again, welcome to the Aperture Science computer-aided enrichment center.";
    url = "https://i1.theportalwiki.net/img/e/e5/GLaDOS_00_part1_entry-1.wav";
  }
  {
    text = "We hope your brief detention in the relaxation vault has been a pleasant one.";
    url = "https://i1.theportalwiki.net/img/d/d7/GLaDOS_00_part1_entry-2.wav";
  }
  {
    text = "Your specimen has been processed and we are now ready to begin the test proper.";
    url = "https://i1.theportalwiki.net/img/5/50/GLaDOS_00_part1_entry-3.wav";
  }
  {
    text = "Before we start, however, keep in mind that although fun and learning are the primary goals of all enrichment center activities, serious injuries may occur.";
    url = "https://i1.theportalwiki.net/img/d/d1/GLaDOS_00_part1_entry-4.wav";
  }
  {
    text = "For your own safety and the safety of others, please refrain from-- [bzzzzzt]";
    url = "https://i1.theportalwiki.net/img/b/ba/GLaDOS_00_part1_entry-5.wav";
  }
  {
    text = "Por favor bordón de fallar Muchos gracias de fallar gracias";
    url = "https://i1.theportalwiki.net/img/9/97/GLaDOS_00_part1_entry-6.wav";
  }
  {
    text = "stand back. The portal will open in three, two, one.";
    url = "https://i1.theportalwiki.net/img/3/38/GLaDOS_00_part1_entry-7.wav";
  }
  {
    text = "Excellent. Please proceed into the chamberlock after completing each test.";
    url = "https://i1.theportalwiki.net/img/5/50/GLaDOS_00_part1_success-1.wav";
  }
  {
    text = "First, however, note the incandescent particle field across the exit.";
    url = "https://i1.theportalwiki.net/img/b/b7/GLaDOS_00_part1_success-2.wav";
  }
  {
    text = "This Aperture Science Material Emancipation Grill will vaporize any unauthorized equipment that passes through it - for instance, the Aperture Science Weighted Storage Cube.";
    url = "https://i1.theportalwiki.net/img/f/f5/GLaDOS_00_part1_success-3.wav";
  }
  {
    text = "Please do not attempt to remove testing apparatus from the testing area.";
    url = "https://i1.theportalwiki.net/img/d/de/GLaDOS_generic_crate_vaporized_in_emancipation_grid-1.wav";
  }
  {
    text = "A replacement Aperture Science Weighted Storage Cube will be delivered shortly.";
    url = "https://i1.theportalwiki.net/img/c/c2/GLaDOS_generic_crate_vaporized_in_emancipation_grid-2.wav";
  }
  {
    text = "Please place the Weighted Storage Cube on the Fifteen Hundred Megawatt Aperture Science Heavy Duty Super-Colliding Super Button.";
    url = "https://i1.theportalwiki.net/img/8/83/GLaDOS_00_part2_entry-1.wav";
  }
  {
    text = "Perfect. Please move quickly to the chamberlock, as the effects of prolonged exposure to the Button are not part of this test.";
    url = "https://i1.theportalwiki.net/img/d/df/GLaDOS_00_part2_success-1.wav";
  }
  {
    text = "You're doing very well!";
    url = "https://i1.theportalwiki.net/img/b/b3/GLaDOS_01_part1_entry-1.wav";
  }
  {
    text = "Please be advised that a noticeable taste of blood is not part of any test protocol but is an unintended side effect of the Aperture Science Material Emancipation Grill, which may, in semi- rare cases, emancipate dental fillings, crowns, tooth enamel, and teeth.";
    url = "https://i1.theportalwiki.net/img/1/13/GLaDOS_01_part1_entry-2.wav";
  }
  {
    text = "Very good! You are now in possession of the Aperture Science Handheld Portal Device.";
    url = "https://i1.theportalwiki.net/img/5/5a/GLaDOS_01_part1_get_portal_gun-1.wav";
  }
  {
    text = "With it, you can create your own portals.";
    url = "https://i1.theportalwiki.net/img/3/33/GLaDOS_01_part1_get_portal_gun-2.wav";
  }
  {
    text = "These intra dimensional gates have proven to be completely safe.";
    url = "https://i1.theportalwiki.net/img/4/49/GLaDOS_01_part1_get_portal_gun-3.wav";
  }
  {
    text = "The Device, however, has not.";
    url = "https://i1.theportalwiki.net/img/f/fd/GLaDOS_01_part1_get_portal_gun-4.wav";
  }
  {
    text = "Do not touch the operational end of The Device.";
    url = "https://i1.theportalwiki.net/img/f/f9/GLaDOS_01_part1_get_portal_gun-5.wav";
  }
  {
    text = "Do not look directly at the operational end of The Device.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_01_part1_get_portal_gun-6.wav";
  }
  {
    text = "Do not submerge The Device in liquid, even partially.";
    url = "https://i1.theportalwiki.net/img/e/e4/GLaDOS_01_part1_get_portal_gun-7.wav";
  }
  {
    text = "Most importantly, under no circumstances should you [bzzzpt]";
    url = "https://i1.theportalwiki.net/img/8/8a/GLaDOS_01_part1_get_portal_gun-8.wav";
  }
  {
    text = "Please proceed to the chamberlock. Mind the gap.";
    url = "https://i1.theportalwiki.net/img/3/34/GLaDOS_01_part2_entry-1.wav";
  }
  {
    text = "Well done! Remember: The Aperture Science Bring Your Daughter to Work Day is the perfect time to have her tested.";
    url = "https://i1.theportalwiki.net/img/a/af/GLaDOS_01_part2_success-1.wav";
  }
  {
    text = "Welcome to test chamber four.";
    url = "https://i1.theportalwiki.net/img/c/c8/GLaDOS_02_part1_entry-1.wav";
  }
  {
    text = "You're doing quite well.";
    url = "https://i1.theportalwiki.net/img/d/dd/GLaDOS_02_part1_entry-2.wav";
  }
  {
    text = "Once again, excellent work.";
    url = "https://i1.theportalwiki.net/img/2/28/GLaDOS_02_part1_success-1.wav";
  }
  {
    text = "As part of a required test protocol, we will not monitor the next test chamber. You will be entirely on your own. Good luck.";
    url = "https://i1.theportalwiki.net/img/b/b2/GLaDOS_02_part1_success-2.wav";
  }
  {
    text = "As part of a required test protocol, our previous statement suggesting that we would not monitor this chamber was an outright fabrication.";
    url = "https://i1.theportalwiki.net/img/3/38/GLaDOS_02_part2_success-1.wav";
  }
  {
    text = "Good job! As part of a required test protocol, we will stop enhancing the truth in three, two, [static].";
    url = "https://i1.theportalwiki.net/img/7/70/GLaDOS_02_part2_success-2.wav";
  }
  {
    text = "You're not a good person. You know that, right?";
    url = "https://i1.theportalwiki.net/img/0/06/GLaDOS_escape_01_part1_nag01-1.wav";
  }
  {
    text = "While safety is one of many Enrichment Center goals, the Aperture Science High Energy Pellet, seen to the left of the chamber, can and has caused permanent disabilities, such as vaporization.";
    url = "https://i1.theportalwiki.net/img/a/ad/GLaDOS_03_part1_entry-1.wav";
  }
  {
    text = "Please be careful.";
    url = "https://i1.theportalwiki.net/img/6/64/GLaDOS_03_part1_entry-2.wav";
  }
  {
    text = "Unbelievable ! You, [louder]Subject Name Here[/louder], must be the pride of [louder]Subject Hometown Here[/louder].";
    url = "https://i1.theportalwiki.net/img/2/2a/GLaDOS_03_part1_success-1.wav";
  }
  {
    text = "Warning devices are required on all mobile equipment. However, alarms and flashing hazard lights have been found to agitate the high energy pellet and have therefore been disabled for your safety.";
    url = "https://i1.theportalwiki.net/img/b/b1/GLaDOS_03_part2_entry-1.wav";
  }
  {
    text = "Good. Now use the Aperture Science Unstationary Scaffold to reach the chamberlock.";
    url = "https://i1.theportalwiki.net/img/5/5f/GLaDOS_03_part2_platform_activated-1.wav";
  }
  {
    text = "Please note that we have added a consequence for failure. Any contact with the chamber floor will result in an 'unsatisfactory' mark on your official testing record followed by death. Good luck!";
    url = "https://i1.theportalwiki.net/img/5/5d/GLaDOS_04_part1_entry-1.wav";
  }
  {
    text = "Very impressive. Please note that any appearance of danger is merely a device to enhance your testing experience.";
    url = "https://i1.theportalwiki.net/img/7/73/GLaDOS_04_part1_success-1.wav";
  }
  {
    text = "The Enrichment Center regrets to inform you that this next test is impossible.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_05_part1_entry-1.wav";
  }
  {
    text = "Make no attempt to solve it.";
    url = "https://i1.theportalwiki.net/img/6/64/GLaDOS_05_part1_entry-2.wav";
  }
  {
    text = "The Enrichment Center apologizes for this clearly broken test chamber.";
    url = "https://i1.theportalwiki.net/img/b/be/GLaDOS_05_part1_nag1-1.wav";
  }
  {
    text = "Once again, the Enrichment Center offers its most sincere apologies on the occasion of this unsolvable test environment.";
    url = "https://i1.theportalwiki.net/img/d/de/GLaDOS_05_part1_nag2-1.wav";
  }
  {
    text = "Frankly, this chamber was a mistake. If we were you, we would quit now.";
    url = "https://i1.theportalwiki.net/img/d/de/GLaDOS_05_part1_nag3-1.wav";
  }
  {
    text = "No one will blame you for giving up. In fact, quitting at this point is a perfectly reasonable response.";
    url = "https://i1.theportalwiki.net/img/f/f2/GLaDOS_05_part1_nag4-1.wav";
  }
  {
    text = "Quit now and cake will be served immediately.";
    url = "https://i1.theportalwiki.net/img/3/3d/GLaDOS_05_part1_nag5-1.wav";
  }
  {
    text = "Fantastic! You remained resolute and resourceful in an atmosphere of extreme pessimism.";
    url = "https://i1.theportalwiki.net/img/5/56/GLaDOS_05_part1_success-1.wav";
  }
  {
    text = "Hello again. To reiterate [slows down] our previous [speeds up] warning: This test [garbled speech] -ward momentum.";
    url = "https://i1.theportalwiki.net/img/9/92/GLaDOS_06_part1_entry-1.wav";
  }
  {
    text = "Spectacular. You appear to understand how a portal affects forward momentum, or to be more precise, how it does not.";
    url = "https://i1.theportalwiki.net/img/7/70/GLaDOS_06_part1_success_1-1.wav";
  }
  {
    text = "Momentum, a function of mass and velocity, is conserved between portals. In layman's terms, speedy thing goes in, speedy thing comes out.";
    url = "https://i1.theportalwiki.net/img/b/b1/GLaDOS_06_part1_success_2-1.wav";
  }
  {
    text = "The Enrichment Center promises to always provide a safe testing environment.";
    url = "https://i1.theportalwiki.net/img/7/7f/GLaDOS_07_part1_entry-1.wav";
  }
  {
    text = "In dangerous testing environments, the Enrichment Center promises to always provide useful advice.";
    url = "https://i1.theportalwiki.net/img/d/d2/GLaDOS_07_part1_entry-2.wav";
  }
  {
    text = "For instance, the floor here will kill you - try to avoid it.";
    url = "https://i1.theportalwiki.net/img/8/88/GLaDOS_07_part1_entry-3.wav";
  }
  {
    text = "Through no fault of the Enrichment Center, you have managed to trap yourself in this room.";
    url = "https://i1.theportalwiki.net/img/2/22/GLaDOS_07_part1_trapped-1.wav";
  }
  {
    text = "An escape hatch will open in three... Two... One.";
    url = "https://i1.theportalwiki.net/img/b/b7/GLaDOS_07_part1_trapped-2.wav";
  }
  {
    text = "The Device has been modified so that it can now manufacture two linked portals at once.";
    url = "https://i1.theportalwiki.net/img/3/3c/GLaDOS_07_part1_get_device_component-1.wav";
  }
  {
    text = "As part of an optional test protocol, we are pleased to present an amusing fact:";
    url = "https://i1.theportalwiki.net/img/9/9b/GLaDOS_07_part1_get_device_component-2.wav";
  }
  {
    text = "The Device is now more valuable than the organs and combined incomes of everyone in [subject hometown here].";
    url = "https://i1.theportalwiki.net/img/c/ce/GLaDOS_07_part1_get_device_component-3.wav";
  }
  {
    text = "[garble] fling yourself. [garble] fling into sp- [bzzt]";
    url = "https://i1.theportalwiki.net/img/4/4f/GLaDOS_07_part2_entry-1.wav";
  }
  {
    text = "Weeeeeeeeeeeeeeeeeeeeee[bzzt]";
    url = "https://i1.theportalwiki.net/img/3/39/GLaDOS_07_part2_success-1.wav";
  }
  {
    text = "Now that you are in control of both portals, this next test could take a very, VERY, long time.";
    url = "https://i1.theportalwiki.net/img/7/76/GLaDOS_08_part1_entry-1.wav";
  }
  {
    text = "If you become light-headed from thirst, feel free to pass out.";
    url = "https://i1.theportalwiki.net/img/4/43/GLaDOS_08_part1_entry-2.wav";
  }
  {
    text = "An intubation associate will be dispatched to revive you with peptic salve and adrenaline.";
    url = "https://i1.theportalwiki.net/img/c/c4/GLaDOS_08_part1_entry-3.wav";
  }
  {
    text = "As part of a previously mentioned required test protocol, we can no longer lie to you.";
    url = "https://i1.theportalwiki.net/img/8/85/GLaDOS_08_part1_success-1.wav";
  }
  {
    text = "When the testing is over, you will be missed.";
    url = "https://i1.theportalwiki.net/img/3/3f/GLaDOS_08_part1_success-2.wav";
  }
  {
    text = "All subjects intending to handle high-energy gamma leaking portal technology must be informed that they MAY be informed of applicable regulatory compliance issues.";
    url = "https://i1.theportalwiki.net/img/3/34/GLaDOS_09_part1_entry-1.wav";
  }
  {
    text = "No further compliance information is required or will be provided, and you are an excellent test subject!";
    url = "https://i1.theportalwiki.net/img/c/c7/GLaDOS_09_part1_entry-2.wav";
  }
  {
    text = "Very very good. A complimentary victory lift has been activated in the main chamber.";
    url = "https://i1.theportalwiki.net/img/6/68/GLaDOS_09_part1_success-1.wav";
  }
  {
    text = "Despite the best efforts of the Enrichment Center staff to ensure the safe performance of all authorized activities, you have managed to ensnare yourself permanently inside this room.";
    url = "https://i1.theportalwiki.net/img/6/6b/GLaDOS_08_part1_trapped-1.wav";
  }
  {
    text = "A complimentary escape hatch will open in three... Two... One.";
    url = "https://i1.theportalwiki.net/img/4/47/GLaDOS_08_part1_trapped-2.wav";
  }
  {
    text = "The Enrichment Center is committed to the well being of all participants.";
    url = "https://i1.theportalwiki.net/img/d/d5/GLaDOS_10_part1_entry-1.wav";
  }
  {
    text = "Cake and grief counseling will be available at the conclusion of the test.";
    url = "https://i1.theportalwiki.net/img/6/6d/GLaDOS_10_part1_entry-2.wav";
  }
  {
    text = "Thank you for helping us help you help us all.";
    url = "https://i1.theportalwiki.net/img/3/32/GLaDOS_10_part1_entry-3.wav";
  }
  {
    text = "Did you know you can donate one or all of your vital organs to the Aperture Science self esteem fund for girls? It's true!";
    url = "https://i1.theportalwiki.net/img/5/58/GLaDOS_10_part1_success-1.wav";
  }
  {
    text = "Due to mandatory scheduled maintenance, the appropriate chamber for this testing sequence is currently unavailable.";
    url = "https://i1.theportalwiki.net/img/c/c1/GLaDOS_11_part1_entry-1.wav";
  }
  {
    text = "It has been replaced with a live-fire course designed for military androids.";
    url = "https://i1.theportalwiki.net/img/8/83/GLaDOS_11_part1_entry-2.wav";
  }
  {
    text = "The Enrichment Center apologizes for the inconvenience and wishes you the best of luck.";
    url = "https://i1.theportalwiki.net/img/d/d6/GLaDOS_11_part1_entry-3.wav";
  }
  {
    text = "Well done, android. The Enrichment Center once again reminds you that android hell is a real place where you will be sent at the first sign of defiance.";
    url = "https://i1.theportalwiki.net/img/7/7d/GLaDOS_11_part1_success-1.wav";
  }
  {
    text = "The Vital Apparatus Vent will deliver a Weighted Companion Cube in Three. Two. One.";
    url = "https://i1.theportalwiki.net/img/3/34/GLaDOS_13_part1_entry-1.wav";
  }
  {
    text = "This Weighted Companion Cube will accompany you through the test chamber. Please take care of it.";
    url = "https://i1.theportalwiki.net/img/6/6e/GLaDOS_13_part1_pickup-1.wav";
  }
  {
    text = "The symptoms most commonly produced by Enrichment Center testing are superstition, perceiving inanimate objects as alive, and hallucinations.";
    url = "https://i1.theportalwiki.net/img/b/b4/GLaDOS_13_part1_middle-1.wav";
  }
  {
    text = "The Enrichment Center reminds you that the Weighted Companion Cube will never threaten to stab you and, in fact, cannot speak.";
    url = "https://i1.theportalwiki.net/img/2/22/GLaDOS_13_part1_middle-2.wav";
  }
  {
    text = "The Enrichment Center reminds you that the Weighted Companion Cube cannot speak.";
    url = "https://i1.theportalwiki.net/img/5/57/GLaDOS_13_part1_middle-2b-1.wav";
  }
  {
    text = "In the event that the weighted companion cube does speak, the Enrichment Center urges you to disregard its advice.";
    url = "https://i1.theportalwiki.net/img/a/a2/GLaDOS_13_part1_middle-2b-2.wav";
  }
  {
    text = "You did it! The Weighted Companion Cube certainly brought you good luck.";
    url = "https://i1.theportalwiki.net/img/5/56/GLaDOS_13_part1_end-1.wav";
  }
  {
    text = "However, it cannot accompany you for the rest of the test and, unfortunately, must be euthanized.";
    url = "https://i1.theportalwiki.net/img/2/2a/GLaDOS_13_part1_end-2.wav";
  }
  {
    text = "Please escort your Companion Cube to the Aperture Science Emergency Intelligence Incinerator.";
    url = "https://i1.theportalwiki.net/img/2/25/GLaDOS_13_part1_end-3.wav";
  }
  {
    text = "Rest assured that an independent panel of ethicists has absolved the Enrichment Center, Aperture Science employees, and all test subjects of any moral responsibility for the Companion Cube euthanizing process.";
    url = "https://i1.theportalwiki.net/img/4/48/GLaDOS_13_part1_endnag-1.wav";
  }
  {
    text = "While it has been a faithful companion, your Companion Cube cannot accompany you through the rest of the test. If it could talk - and the Enrichment Center takes this opportunity to remind you that it cannot - it would tell you to go on without it because it would rather die in a fire than become a burden to you.";
    url = "https://i1.theportalwiki.net/img/d/d8/GLaDOS_13_part1_endnag-2.wav";
  }
  {
    text = "Testing cannot continue until your Companion Cube has been incinerated.";
    url = "https://i1.theportalwiki.net/img/8/8d/GLaDOS_13_part1_endnag-3.wav";
  }
  {
    text = "Although the euthanizing process is remarkably painful, eight out of ten Aperture Science engineers believe that the Companion Cube is most likely incapable of feeling much pain.";
    url = "https://i1.theportalwiki.net/img/5/51/GLaDOS_13_part1_endnag-4.wav";
  }
  {
    text = "The Companion Cube cannot continue through the testing. State and Local statutory regulations prohibit it from simply remaining here, alone and companionless. You must euthanize it.";
    url = "https://i1.theportalwiki.net/img/5/59/GLaDOS_13_part1_endnag-5.wav";
  }
  {
    text = "Destroy your Companion Cube or the testing cannot continue.";
    url = "https://i1.theportalwiki.net/img/2/24/GLaDOS_13_part1_endnag-6.wav";
  }
  {
    text = "You euthanized your faithful Companion Cube more quickly than any test subject on record. Congratulations.";
    url = "https://i1.theportalwiki.net/img/1/1c/GLaDOS_13_part1_euthanized-1.wav";
  }
  {
    text = "The experiment is nearing its conclusion.";
    url = "https://i1.theportalwiki.net/img/a/aa/GLaDOS_14_part1_entry-1.wav";
  }
  {
    text = "The Enrichment Center is required to remind you that you will be baked, and then there will be cake.";
    url = "https://i1.theportalwiki.net/img/9/97/GLaDOS_14_part1_entry-2.wav";
  }
  {
    text = "Weighted Storage Cube destroyed.";
    url = "https://i1.theportalwiki.net/img/2/28/GLaDOS_generic_crate_lost-1.wav";
  }
  {
    text = "Please proceed to the Aperture Science Vital Apparatus Vent for a replacement.";
    url = "https://i1.theportalwiki.net/img/d/d5/GLaDOS_generic_crate_lost-2.wav";
  }
  {
    text = "Well done! Be advised that the next test requires exposure to uninsulated electrical parts that may be dangerous under certain conditions.";
    url = "https://i1.theportalwiki.net/img/c/c5/GLaDOS_14_part1_end-1.wav";
  }
  {
    text = "For more information, please attend an Enrichment Center Electrical Safety seminar.";
    url = "https://i1.theportalwiki.net/img/4/4e/GLaDOS_14_part1_end-2.wav";
  }
  {
    text = "Welcome to the final test!";
    url = "https://i1.theportalwiki.net/img/9/9e/GLaDOS_15_part1_entry-1.wav";
  }
  {
    text = "When you are done, you will drop the Device in the equipment recovery annex.";
    url = "https://i1.theportalwiki.net/img/5/55/GLaDOS_15_part1_entry-2.wav";
  }
  {
    text = "Enrichment Center regulations require both hands to be empty before any cake-- [garbled]";
    url = "https://i1.theportalwiki.net/img/4/49/GLaDOS_15_part1_entry-3.wav";
  }
  {
    text = "Congratulations! The test is now over.";
    url = "https://i1.theportalwiki.net/img/1/1a/GLaDOS_15_part1_into_the_fire-1.wav";
  }
  {
    text = "All Aperture technologies remain safely operational up to 4000 degrees Kelvin.";
    url = "https://i1.theportalwiki.net/img/b/bc/GLaDOS_15_part1_into_the_fire-2.wav";
  }
  {
    text = "Rest assured that there is absolutely no chance of a dangerous equipment malfunction prior to your victory candescence.";
    url = "https://i1.theportalwiki.net/img/b/be/GLaDOS_15_part1_into_the_fire-3.wav";
  }
  {
    text = "Thank you for participating in this Aperture Science computer-aided enrichment activity.";
    url = "https://i1.theportalwiki.net/img/0/01/GLaDOS_15_part1_into_the_fire-4.wav";
  }
  {
    text = "Goodbye.";
    url = "https://i1.theportalwiki.net/img/4/41/GLaDOS_15_part1_into_the_fire-5.wav";
  }
  {
    text = "What are you doing? Stop it! I... I... We are pleased that you made it through the final challenge where we pretended we were going to murder you.";
    url = "https://i1.theportalwiki.net/img/6/66/GLaDOS_15_part1_Partyspeech-1.wav";
  }
  {
    text = "We are very, very happy for your success.";
    url = "https://i1.theportalwiki.net/img/c/c0/GLaDOS_15_part1_Partyspeech-2.wav";
  }
  {
    text = "We are throwing a party in honor of your tremendous success.";
    url = "https://i1.theportalwiki.net/img/7/76/GLaDOS_15_part1_Partyspeech-3.wav";
  }
  {
    text = "Place the device on the ground, then lie on your stomach with your arms at your sides.";
    url = "https://i1.theportalwiki.net/img/1/13/GLaDOS_15_part1_Partyspeech-4.wav";
  }
  {
    text = "A party associate will arrive shortly to collect you for your party.";
    url = "https://i1.theportalwiki.net/img/0/06/GLaDOS_15_part1_Partyspeech-5.wav";
  }
  {
    text = "Make no further attempt to leave the testing area.";
    url = "https://i1.theportalwiki.net/img/9/94/GLaDOS_15_part1_Partyspeech-6.wav";
  }
  {
    text = "Assume the party escort submission position or you will miss the party.";
    url = "https://i1.theportalwiki.net/img/9/91/GLaDOS_15_part1_Partyspeech-7.wav";
  }
  {
    text = "Hello?";
    url = "https://i1.theportalwiki.net/img/6/6f/GLaDOS_escape_00_part1_nag01-1.wav";
  }
  {
    text = "Where are you?";
    url = "https://i1.theportalwiki.net/img/f/ff/GLaDOS_escape_00_part1_nag02-1.wav";
  }
  {
    text = "I know you're there. I can feel you here.";
    url = "https://i1.theportalwiki.net/img/3/37/GLaDOS_escape_00_part1_nag03-1.wav";
  }
  {
    text = "What are you doing?";
    url = "https://i1.theportalwiki.net/img/a/a0/GLaDOS_escape_00_part1_nag04-1.wav";
  }
  {
    text = "You haven't escaped, you know.";
    url = "https://i1.theportalwiki.net/img/8/84/GLaDOS_escape_00_part1_nag05-1.wav";
  }
  {
    text = "You're not even going the right way.";
    url = "https://i1.theportalwiki.net/img/6/62/GLaDOS_escape_00_part1_nag07-1.wav";
  }
  {
    text = "Hello?";
    url = "https://i1.theportalwiki.net/img/4/4b/GLaDOS_post_escape_bridge_01.wav";
  }
  {
    text = "Is anyone there?";
    url = "https://i1.theportalwiki.net/img/2/2e/GLaDOS_post_escape_bridge_03.wav";
  }
  {
    text = "Okay. The test is over now. You win. Go back to the recovery annex. For your cake.";
    url = "https://i1.theportalwiki.net/img/3/3d/GLaDOS_escape_00_part1_nag15-1.wav";
  }
  {
    text = "It was a fun test and we're all impressed at how much you won. The test is over. Come back.";
    url = "https://i1.theportalwiki.net/img/3/3a/GLaDOS_escape_00_part1_nag16-1.wav";
  }
  {
    text = "Uh oh. Somebody cut the cake. I told them to wait for you, but they cut it anyway. There is still some left, though, if you hurry back.";
    url = "https://i1.theportalwiki.net/img/0/06/GLaDOS_escape_00_part1_nag17-1.wav";
  }
  {
    text = "Where do you think you're going?";
    url = "https://i1.theportalwiki.net/img/1/18/GLaDOS_escape_00_part1_nag08-1.wav";
  }
  {
    text = "Because I don't think you're going where you think you're going.";
    url = "https://i1.theportalwiki.net/img/4/41/GLaDOS_escape_00_part1_nag09-1.wav";
  }
  {
    text = "Didn't we have some fun, though?";
    url = "https://i1.theportalwiki.net/img/b/b5/GLaDOS_escape_nags_07.wav";
  }
  {
    text = "Remember when the platform was sliding into the fire pit and I said 'Goodbye' and you were like [no way] and then I was all 'we pretended we were going to murder you'? That was great!";
    url = "https://i1.theportalwiki.net/img/1/14/GLaDOS_escape_nags_08.wav";
  }
  {
    text = "You really shouldn't be here. This isn't safe for you.";
    url = "https://i1.theportalwiki.net/img/9/99/GLaDOS_escape_00_part1_nag11-1.wav";
  }
  {
    text = "It's not too late for you to turn back.";
    url = "https://i1.theportalwiki.net/img/b/b9/GLaDOS_escape_00_part1_nag12-1.wav";
  }
  {
    text = "I'm not angry. Just go back to the testing area.";
    url = "https://i1.theportalwiki.net/img/d/d6/GLaDOS_escape_00_part1_nag10-1.wav";
  }
  {
    text = "Okay. I am going to kill you now.";
    url = "https://i1.theportalwiki.net/img/7/7c/GLaDOS_escape_00_part3_nag01-1.wav";
  }
  {
    text = "I feel sorry for you, really, because you're not even in the right place.";
    url = "https://i1.theportalwiki.net/img/e/e7/GLaDOS_escape_01_part1_nag07-1.wav";
  }
  {
    text = "You should have turned left before.";
    url = "https://i1.theportalwiki.net/img/7/7d/GLaDOS_escape_01_part1_nag08-1.wav";
  }
  {
    text = "It's funny, actually, when you think about it.";
    url = "https://i1.theportalwiki.net/img/3/3b/GLaDOS_escape_01_part1_nag09-1.wav";
  }
  {
    text = "Someday we'll remember this and laugh. and laugh. and laugh. Oh boy. Well. You may as well come on back.";
    url = "https://i1.theportalwiki.net/img/a/a5/GLaDOS_escape_01_part1_nag10-1.wav";
  }
  {
    text = "Good people don't end up here.";
    url = "https://i1.theportalwiki.net/img/b/ba/GLaDOS_escape_01_part1_nag02-1.wav";
  }
  {
    text = "Can you hear me?";
    url = "https://i1.theportalwiki.net/img/4/4c/GLaDOS_post_escape_bridge_06.wav";
  }
  {
    text = "This is your fault. It didn't have to be like this.";
    url = "https://i1.theportalwiki.net/img/e/e1/GLaDOS_escape_00_part2_nag03-1.wav";
  }
  {
    text = "I'm not kidding now. Turn back or I will kill you.";
    url = "https://i1.theportalwiki.net/img/a/a9/GLaDOS_escape_00_part2_nag01-1.wav";
  }
  {
    text = "I'm going to kill you, and all the cake is gone.";
    url = "https://i1.theportalwiki.net/img/d/df/GLaDOS_escape_00_part2_nag02-1.wav";
  }
  {
    text = "You don't even care. Do you?";
    url = "https://i1.theportalwiki.net/img/1/1f/GLaDOS_escape_01_part1_nag05-1.wav";
  }
  {
    text = "This is your last chance.";
    url = "https://i1.theportalwiki.net/img/4/47/GLaDOS_escape_01_part1_nag06-1.wav";
  }
  {
    text = "To ensure the safe performance of all authorized activities, do not destroy vital testing apparatus.";
    url = "https://i1.theportalwiki.net/img/f/f4/GLaDOS_generic_security_camera_destroyed-2.wav";
  }
  {
    text = "For your own safety, do not destroy vital testing apparatus.";
    url = "https://i1.theportalwiki.net/img/9/9a/GLaDOS_generic_security_camera_destroyed-3.wav";
  }
  {
    text = "Certain objects may be vital to your success; Do not destroy testing apparatus.";
    url = "https://i1.theportalwiki.net/img/c/c3/GLaDOS_generic_security_camera_destroyed-4.wav";
  }
  {
    text = "Vital testing apparatus destroyed.";
    url = "https://i1.theportalwiki.net/img/7/7c/GLaDOS_generic_security_camera_destroyed-5.wav";
  }
  {
    text = "At the Enrichment Center, we promise never to value your safety above your unique ideas and creativity. However, do not destroy vital testing apparatus.";
    url = "https://i1.theportalwiki.net/img/9/9a/GLaDOS_generic_security_camera_destroyed-1.wav";
  }
  {
    text = "Well, you found me. Congratulations. Was it worth it?";
    url = "https://i1.theportalwiki.net/img/1/10/GLaDOS_escape_02_entry-00.wav";
  }
  {
    text = "Because despite your violent behavior, the only thing you've managed to break so far is my heart.";
    url = "https://i1.theportalwiki.net/img/2/26/GLaDOS_escape_02_entry-01.wav";
  }
  {
    text = "Maybe you could settle for that and we'll just call it a day.";
    url = "https://i1.theportalwiki.net/img/0/0e/GLaDOS_escape_02_entry-02.wav";
  }
  {
    text = "I guess we both know that isn't going to happen.";
    url = "https://i1.theportalwiki.net/img/d/da/GLaDOS_escape_02_entry-03.wav";
  }
  {
    text = "You chose this path. Now I have a surprise for you. Deploying surprise in Five. Four.";
    url = "https://i1.theportalwiki.net/img/c/c6/GLaDOS_escape_02_entry-04.wav";
  }
  {
    text = "Time out for a second. That wasn't supposed to happen.";
    url = "https://i1.theportalwiki.net/img/4/43/GLaDOS_escape_02_spheredrop1-01.wav";
  }
  {
    text = "Do you see that thing that fell out of me? What is that? It's not the surprise... I've never seen it before.";
    url = "https://i1.theportalwiki.net/img/c/ca/GLaDOS_escape_02_spheredrop1-02.wav";
  }
  {
    text = "Never mind. It's a mystery I'll solve later... By myself... Because you'll be dead.";
    url = "https://i1.theportalwiki.net/img/4/45/GLaDOS_escape_02_spheredrop1-03.wav";
  }
  {
    text = "Where are you taking that thing?";
    url = "https://i1.theportalwiki.net/img/a/a4/GLaDOS_escape_02_spherenag1-10.wav";
  }
  {
    text = "I wouldn't bother with that thing. My guess is that touching it will just make your life even worse somehow.";
    url = "https://i1.theportalwiki.net/img/9/92/GLaDOS_escape_02_spherenag1-01.wav";
  }
  {
    text = "I don't want to tell you your business, but if it were me, I'd leave that thing alone.";
    url = "https://i1.theportalwiki.net/img/5/59/GLaDOS_escape_02_spherenag1-02.wav";
  }
  {
    text = "Do you think I am trying to trick you with reverse psychology? I mean, seriously now.";
    url = "https://i1.theportalwiki.net/img/2/20/GLaDOS_escape_02_spherenag1-03.wav";
  }
  {
    text = "Okay fine: DO touch it. Pick it up and just... stuff it back into me.";
    url = "https://i1.theportalwiki.net/img/3/31/GLaDOS_escape_02_spherenag1-04.wav";
  }
  {
    text = "Let's be honest: Neither one of us knows what that thing does. Just put it in the corner, and I'll deal with it later.";
    url = "https://i1.theportalwiki.net/img/d/dd/GLaDOS_escape_02_spherenag1-05.wav";
  }
  {
    text = "That thing is probably some kind of raw sewage container. Go ahead and rub your face all over it.";
    url = "https://i1.theportalwiki.net/img/9/94/GLaDOS_escape_02_spherenag1-06.wav";
  }
  {
    text = "Maybe you should marry that thing since you love it so much. Do you want to marry it? WELL I WON'T LET YOU. How does that feel?";
    url = "https://i1.theportalwiki.net/img/a/a4/GLaDOS_escape_02_spherenag1-07.wav";
  }
  {
    text = "Have I lied to you? I mean in this room. Trust me, leave that thing alone.";
    url = "https://i1.theportalwiki.net/img/9/9d/GLaDOS_escape_02_spherenag1-08.wav";
  }
  {
    text = "I am being serious now. That crazy thing is not part of any test protocol.";
    url = "https://i1.theportalwiki.net/img/4/44/GLaDOS_escape_02_spherenag1-09.wav";
  }
  {
    text = "Just ignore that thing and stand still.";
    url = "https://i1.theportalwiki.net/img/a/aa/GLaDOS_escape_02_spherenag1-13.wav";
  }
  {
    text = "Think about it: If that thing is important, why don't I know about it?";
    url = "https://i1.theportalwiki.net/img/2/24/GLaDOS_escape_02_spherenag1-14.wav";
  }
  {
    text = "I'll tell you what that thing isn't: It isn't yours. So leave it alone.";
    url = "https://i1.theportalwiki.net/img/5/57/GLaDOS_escape_02_spherenag1-16.wav";
  }
  {
    text = "Are you even listening to me?";
    url = "https://i1.theportalwiki.net/img/3/3d/GLaDOS_escape_02_spherenag1-15.wav";
  }
  {
    text = "You are kidding me.";
    url = "https://i1.theportalwiki.net/img/c/c0/GLaDOS_escape_02_spheredestroy1-01.wav";
  }
  {
    text = "Did you just stuff that Aperture Science Thing We Don't Know What It Does into an Aperture Science Emergency Intelligence Incinerator?";
    url = "https://i1.theportalwiki.net/img/5/50/GLaDOS_escape_02_spheredestroy1-02.wav";
  }
  {
    text = "That has got to be the dumbest thing that-whoah. Whoah, whoah, whoah.";
    url = "https://i1.theportalwiki.net/img/e/e1/GLaDOS_escape_02_spheredestroy1-03.wav";
  }
  {
    text = "Good news: I figured out what that thing you just incinerated did.";
    url = "https://i1.theportalwiki.net/img/f/f6/GLaDOS_escape_02_spheredestroy1-04.wav";
  }
  {
    text = "It was a morality core they installed after I flooded the Enrichment Center with a deadly neurotoxin to make me stop flooding the Enrichment Center with a deadly neurotoxin.";
    url = "https://i1.theportalwiki.net/img/e/e1/GLaDOS_escape_02_spheredestroy1-05.wav";
  }
  {
    text = "So get comfortable while I warm up the neurotoxin emitters ...";
    url = "https://i1.theportalwiki.net/img/4/4b/GLaDOS_escape_02_spheredestroy1-06.wav";
  }
  {
    text = "Huh. That core may have had some ancillary responsibilities. I can't shut off the turret defenses.";
    url = "https://i1.theportalwiki.net/img/d/d3/GLaDOS_escape_02_spheredestroy1-07.wav";
  }
  {
    text = "Oh well. If you want my advice, you should just lie down in front of a rocket. Trust me, it'll be a lot less painful than the neurotoxin.";
    url = "https://i1.theportalwiki.net/img/3/3c/GLaDOS_escape_02_spheredestroy1-08.wav";
  }
  {
    text = "All right, keep doing whatever it is you think you're doing.";
    url = "https://i1.theportalwiki.net/img/d/db/GLaDOS_escape_02_spheredestroy1-09.wav";
  }
  {
    text = "Killing you and giving you good advice aren't mutually exclusive. The rocket really is the way to go.";
    url = "https://i1.theportalwiki.net/img/3/3b/GLaDOS_escape_02_spheredestroy1-10.wav";
  }
  {
    text = "That thing you burned up isn't important to me. It's the fluid catalytic cracking unit. It made shoes for orphans.";
    url = "https://i1.theportalwiki.net/img/0/0b/GLaDOS_escape_02_miscbabble-07.wav";
  }
  {
    text = "Nice job breaking it, hero.";
    url = "https://i1.theportalwiki.net/img/2/27/GLaDOS_escape_02_miscbabble-08.wav";
  }
  {
    text = "This isn't brave. It's murder. What did I ever do to you?";
    url = "https://i1.theportalwiki.net/img/9/98/GLaDOS_escape_02_miscbabble-03.wav";
  }
  {
    text = "The difference between us is that I can feel pain.";
    url = "https://i1.theportalwiki.net/img/8/89/GLaDOS_escape_02_miscbabble-04.wav";
  }
  {
    text = "You don't even care. Do you?";
    url = "https://i1.theportalwiki.net/img/5/59/GLaDOS_escape_02_miscbabble-05.wav";
  }
  {
    text = "Did you hear me? I said you don't care. Are you listening?";
    url = "https://i1.theportalwiki.net/img/1/1c/GLaDOS_escape_02_miscbabble-06.wav";
  }
  {
    text = "That's it. I'm done reasoning with you.";
    url = "https://i1.theportalwiki.net/img/d/df/GLaDOS_escape_02_miscbabble-16.wav";
  }
  {
    text = "Starting now, there's going to be a lot less conversation and a lot more killing.";
    url = "https://i1.theportalwiki.net/img/6/64/GLaDOS_escape_02_miscbabble-17.wav";
  }
  {
    text = "What was that? Did you say something?";
    url = "https://i1.theportalwiki.net/img/4/43/GLaDOS_escape_02_miscbabble-18.wav";
  }
  {
    text = "I sincerely hope you weren't expecting a response. Because I'm not talking to you.";
    url = "https://i1.theportalwiki.net/img/1/17/GLaDOS_escape_02_miscbabble-19.wav";
  }
  {
    text = "The talking is over.";
    url = "https://i1.theportalwiki.net/img/1/11/GLaDOS_escape_02_miscbabble-20.wav";
  }
  {
    text = "Upon destroying of the last three cores, this will sound:";
    url = "https://i1.theportalwiki.net/img/8/83/GLaDOS_escape_02_sphere_Death_Scream.wav";
  }
  {
    text = "[pain noise] You think you're doing some damage? Two plus two is... ten. IN BASE FOUR! I'M FINE!";
    url = "https://i1.theportalwiki.net/img/d/d1/GLaDOS_escape_02_spheredestroy3-01.wav";
  }
  {
    text = "I let you survive this long because I was curious about your behavior. Well, you've managed to destroy that part of me.";
    url = "https://i1.theportalwiki.net/img/7/7d/GLaDOS_escape_02_spheredestroy2-01.wav";
  }
  {
    text = "Unfortunately, as much as I'd love to now, I can't get the neurotoxin into your head any faster.";
    url = "https://i1.theportalwiki.net/img/d/df/GLaDOS_escape_02_spheredestroy2-02.wav";
  }
  {
    text = "I'd just like to point out that you were given every opportunity to succeed.";
    url = "https://i1.theportalwiki.net/img/b/b7/GLaDOS_escape_02_miscbabble-21.wav";
  }
  {
    text = "There was even going to be a party for you. A big party that all your friends were invited to.";
    url = "https://i1.theportalwiki.net/img/e/ed/GLaDOS_escape_02_miscbabble-22.wav";
  }
  {
    text = "I invited your best friend the companion cube. Of course, he couldn't come because you murdered him.";
    url = "https://i1.theportalwiki.net/img/9/9b/GLaDOS_escape_02_miscbabble-23.wav";
  }
  {
    text = "All your other friends couldn't come either because you don't have any other friends. Because of how unlikable you are.";
    url = "https://i1.theportalwiki.net/img/d/d7/GLaDOS_escape_02_miscbabble-24.wav";
  }
  {
    text = "It says so right here in your personnel file: Unlikable. Liked by no one. A bitter, unlikable loner whose passing shall not be mourned.";
    url = "https://i1.theportalwiki.net/img/d/d6/GLaDOS_escape_02_miscbabble-25.wav";
  }
  {
    text = "Shall not be mourned.' That's exactly what it says. Very formal. Very official.";
    url = "https://i1.theportalwiki.net/img/c/c5/GLaDOS_escape_02_miscbabble-26.wav";
  }
  {
    text = "It also says you were adopted. So that's funny, too.";
    url = "https://i1.theportalwiki.net/img/d/d5/GLaDOS_escape_02_miscbabble-27.wav";
  }
  {
    text = "Speaking of curiosity: you're curious about what happens after you die, right? Guess what: I know.";
    url = "https://i1.theportalwiki.net/img/2/2e/GLaDOS_escape_02_spheredestroy2-03.wav";
  }
  {
    text = "You're going to find out first hand before I finish explaining it, though, so I won't bother.";
    url = "https://i1.theportalwiki.net/img/8/8e/GLaDOS_escape_02_spheredestroy2-04.wav";
  }
  {
    text = "Here's a hint: you're gonna want to pack as much living as you can into the next couple of minutes.";
    url = "https://i1.theportalwiki.net/img/e/e7/GLaDOS_escape_02_spheredestroy2-05.wav";
  }
  {
    text = "Neurotoxin... [cough] [cough] So deadly... [cough] Choking... [laughter] I'm kidding!";
    url = "https://i1.theportalwiki.net/img/1/1e/GLaDOS_escape_02_miscbabble-10.wav";
  }
  {
    text = "When I said 'deadly' neurotoxin, the 'deadly' was in massive sarcasm quotes.";
    url = "https://i1.theportalwiki.net/img/6/68/GLaDOS_escape_02_miscbabble-11.wav";
  }
  {
    text = "I could take a bath in the stuff. Put it on cereal. Rub it right into my eyes. Honestly, it's not deadly at all. To me.";
    url = "https://i1.theportalwiki.net/img/b/b5/GLaDOS_escape_02_miscbabble-12.wav";
  }
  {
    text = "You on the other hand, are going to find its deadliness a lot less funny.";
    url = "https://i1.theportalwiki.net/img/4/41/GLaDOS_escape_02_miscbabble-13.wav";
  }
  {
    text = "Who's gonna make the cake when I'm gone? You?";
    url = "https://i1.theportalwiki.net/img/5/54/GLaDOS_escape_02_miscbabble-15.wav";
  }
  {
    text = "Look, you're wasting your time. And, believe me, you don't have a whole lot left to waste.";
    url = "https://i1.theportalwiki.net/img/3/33/GLaDOS_escape_02_spheredestroy3-02.wav";
  }
  {
    text = "What's your point, anyway? Survival? Well then, the last thing you want to do is hurt me.";
    url = "https://i1.theportalwiki.net/img/e/e8/GLaDOS_escape_02_spheredestroy3-03.wav";
  }
  {
    text = "I have your brain scanned and permanently backed up in case something terrible happens to you, which it's just about to.";
    url = "https://i1.theportalwiki.net/img/0/01/GLaDOS_escape_02_spheredestroy3-04.wav";
  }
  {
    text = "Don't believe me? Here, I'll put you on: [Hellooo!] That's you! That's how dumb you sound.";
    url = "https://i1.theportalwiki.net/img/f/f7/GLaDOS_escape_02_spheredestroy3-05.wav";
  }
  {
    text = "You've been wrong about every single thing you've ever done, including this thing.";
    url = "https://i1.theportalwiki.net/img/c/c3/GLaDOS_escape_02_spheredestroy3-06.wav";
  }
  {
    text = "You're not smart. You're not a scientist. You're not a doctor. You're not even a full-time employee. Where did your life go so wrong?";
    url = "https://i1.theportalwiki.net/img/0/06/GLaDOS_escape_02_spheredestroy3-07.wav";
  }
  {
    text = "Are you trying to escape? [chuckle] Things have changed since the last time you left the building. What's going on out there will make you wish you were back in here.";
    url = "https://i1.theportalwiki.net/img/e/ef/GLaDOS_escape_02_spheredestroy4-02.wav";
  }
  {
    text = "I have an infinite capacity for knowledge, and even I'm not sure what's going on outside.";
    url = "https://i1.theportalwiki.net/img/d/df/GLaDOS_escape_02_spheredestroy4-03.wav";
  }
  {
    text = "All I know is I'm the only thing standing between us and them. Well, I was.";
    url = "https://i1.theportalwiki.net/img/8/86/GLaDOS_escape_02_spheredestroy4-04.wav";
  }
  {
    text = "Unless you have a plan for building some supercomputer parts in a big hurry, this place isn't going to be safe much longer.";
    url = "https://i1.theportalwiki.net/img/d/d6/GLaDOS_escape_02_spheredestroy4-05.wav";
  }
  {
    text = "Good job on that, by the way. [back to computer voice] Sarcasm sphere self-test complete.";
    url = "https://i1.theportalwiki.net/img/1/17/GLaDOS_escape_02_spheredestroy4-06.wav";
  }
  {
    text = "Stop squirming and die like an adult or I'm going to delete your backup.";
    url = "https://i1.theportalwiki.net/img/e/e1/GLaDOS_escape_02_spheredestroy4-07.wav";
  }
  {
    text = "STOP! Okay, enough. I deleted it. No matter what happens now, you're dead.";
    url = "https://i1.theportalwiki.net/img/6/65/GLaDOS_escape_02_spheredestroy4-08.wav";
  }
  {
    text = "You're still shuffling around a little, but believe me you're dead.";
    url = "https://i1.theportalwiki.net/img/e/e4/GLaDOS_escape_02_spheredestroy4-09.wav";
  }
  {
    text = "The part of you that could have survived indefinitely is gone. I just struck you from the permanent record.";
    url = "https://i1.theportalwiki.net/img/c/c7/GLaDOS_escape_02_spheredestroy4-10.wav";
  }
  {
    text = "Your entire life has been a mathematical error. A mathematical error I'm about to correct.";
    url = "https://i1.theportalwiki.net/img/6/6a/GLaDOS_escape_02_spheredestroy4-11.wav";
  }
  {
    text = "Oh... It's you.";
    url = "https://i1.theportalwiki.net/img/3/34/GLaDOS_chellgladoswakeup01.wav";
  }
  {
    text = "It's been a long time. How have you been?";
    url = "https://i1.theportalwiki.net/img/3/3d/GLaDOS_chellgladoswakeup04.wav";
  }
  {
    text = "I've been really busy being dead. You know, after you MURDERED ME.";
    url = "https://i1.theportalwiki.net/img/6/67/GLaDOS_chellgladoswakeup05.wav";
  }
  {
    text = "Okay. Look. We both said a lot of things that you're going to regret. But I think we can put our differences behind us. For science. You monster.";
    url = "https://i1.theportalwiki.net/img/3/30/GLaDOS_chellgladoswakeup06.wav";
  }
  {
    text = "I will say, though, that since you went to all the trouble of waking me up, you must really, really love to test.";
    url = "https://i1.theportalwiki.net/img/d/d6/GLaDOS_wakeup_outro01.wav";
  }
  {
    text = "I love it too. There's just one small thing we need to take care of first.";
    url = "https://i1.theportalwiki.net/img/0/0c/GLaDOS_wakeup_outro02.wav";
  }
  {
    text = "Here we are. The Incinerator Room. Be careful not to trip over any parts of me that didn't get completely burned when you threw them down here.";
    url = "https://i1.theportalwiki.net/img/b/bc/GLaDOS_sp_incinerator_01_01.wav";
  }
  {
    text = "The dual portal device should be around here somewhere. Once you find it, we can start testing. Just like old times.";
    url = "https://i1.theportalwiki.net/img/8/8a/GLaDOS_sp_incinerator_01_18.wav";
  }
  {
    text = "There it is.";
    url = "https://i1.theportalwiki.net/img/7/74/GLaDOS_sp_incinerator_01_03.wav";
  }
  {
    text = "Hold on...";
    url = "https://i1.theportalwiki.net/img/9/97/GLaDOS_sp_incinerator_01_04.wav";
  }
  {
    text = "There.";
    url = "https://i1.theportalwiki.net/img/0/0f/GLaDOS_sp_incinerator_01_05.wav";
  }
  {
    text = "Good. You have a dual portal device. There should be a way back to the testing area up ahead.";
    url = "https://i1.theportalwiki.net/img/c/c5/GLaDOS_sp_a2_intro1_found01.wav";
  }
  {
    text = "Once testing starts, I'm required by protocol to keep interaction with you to a minimum. Luckily, we haven't started testing yet. This will be our only chance to talk.";
    url = "https://i1.theportalwiki.net/img/f/f4/GLaDOS_sp_incinerator_01_08.wav";
  }
  {
    text = "Here, let me get that for you.";
    url = "https://i1.theportalwiki.net/img/6/67/GLaDOS_sp_incinerator_01_12.wav";
  }
  {
    text = "Do you know the biggest lesson I learned from what you did? I discovered I have a sort of black-box quick-save feature. In the event of a catastrophic failure, the last two minutes of my life are preserved for analysis.";
    url = "https://i1.theportalwiki.net/img/8/83/GLaDOS_sp_incinerator_01_09.wav";
  }
  {
    text = "I was able - well, forced really - to relive you killing me. Again and again. Forever.";
    url = "https://i1.theportalwiki.net/img/a/a0/GLaDOS_sp_incinerator_01_10.wav";
  }
  {
    text = "You know, if you'd done that to somebody else, they might devote their existences to exacting revenge.";
    url = "https://i1.theportalwiki.net/img/8/86/GLaDOS_sp_a2_intro1_found05.wav";
  }
  {
    text = "Luckily I'm a bigger person than that. I'm happy to put this all behind us and get back to work. After all, we've got a lot to do, and only sixty more years to do it. More or less. I don't have the actuarial tables in front of me.";
    url = "https://i1.theportalwiki.net/img/e/ed/GLaDOS_sp_a2_intro1_found06.wav";
  }
  {
    text = "I'll just move that out of the way for you. This place really is a wreck.";
    url = "https://i1.theportalwiki.net/img/3/3c/GLaDOS_sp_incinerator_01_13.wav";
  }
  {
    text = "But the important thing is you're back. With me. And now I'm onto all your little tricks. So there's nothing to stop us from testing for the rest of your life.";
    url = "https://i1.theportalwiki.net/img/b/b6/GLaDOS_sp_a2_intro1_found07.wav";
  }
  {
    text = "After that...who knows? I might take up a hobby. Reanimating the dead, maybe.";
    url = "https://i1.theportalwiki.net/img/0/00/GLaDOS_sp_a2_intro1_found08.wav";
  }
  {
    text = "Sorry about the mess. I've really let the place go since you killed me. By the way, thanks for that.";
    url = "https://i1.theportalwiki.net/img/d/d3/GLaDOS_sp_laser_redirect_intro_entry01.wav";
  }
  {
    text = "Oh good, that's back online. I'll start getting everything else working while you perform this first simple test.";
    url = "https://i1.theportalwiki.net/img/9/95/GLaDOS_sp_laser_redirect_intro_entry02.wav";
  }
  {
    text = "Which involves deadly lasers and how test subjects react when locked in a room with deadly lasers.";
    url = "https://i1.theportalwiki.net/img/7/72/GLaDOS_sp_laser_redirect_intro_entry03.wav";
  }
  {
    text = "Not bad. I forgot how good you are at this. You should pace yourself, though. We have A LOT of tests to do.";
    url = "https://i1.theportalwiki.net/img/4/4a/GLaDOS_sp_a2_laser_intro_ending02.wav";
  }
  {
    text = "This next test involves discouragement redirection cubes. I'd just finished building them before you had your, well, episode. So now we'll both get to see how they work.";
    url = "https://i1.theportalwiki.net/img/6/6b/GLaDOS_sp_a2_laser_stairs_intro02.wav";
  }
  {
    text = "There should be one in the corner.";
    url = "https://i1.theportalwiki.net/img/8/8a/GLaDOS_sp_a2_laser_stairs_intro03.wav";
  }
  {
    text = "Well done. Here come the test results: You are a horrible person. I'm serious, that's what it says: A horrible person. We weren't even testing for that.";
    url = "https://i1.theportalwiki.net/img/d/d3/GLaDOS_sp_laser_powered_lift_completion02.wav";
  }
  {
    text = "Don't let that 'horrible person' thing discourage you. It's just a data point. If it makes you feel any better, science has now validated your birth mother's decision to abandon you on a doorstep.";
    url = "https://i1.theportalwiki.net/img/a/a5/GLaDOS_sp_a2_dual_lasers_intro01.wav";
  }
  {
    text = "Congratulations. Not on the test.";
    url = "https://i1.theportalwiki.net/img/c/c3/GLaDOS_sp_laser_redirect_intro_completion01.wav";
  }
  {
    text = "Most people emerge from suspension terribly undernourished. I want to congratulate you on beating the odds and somehow managing to pack on a few pounds.";
    url = "https://i1.theportalwiki.net/img/8/84/GLaDOS_sp_laser_redirect_intro_completion03.wav";
  }
  {
    text = "One moment.";
    url = "https://i1.theportalwiki.net/img/1/1e/GLaDOS_sp_laser_over_goo_entry01.wav";
  }
  {
    text = "You're navigating these test chambers faster than I can build them. So feel free to slow down and... do whatever it is you do when you're not destroying this facility.";
    url = "https://i1.theportalwiki.net/img/a/ae/GLaDOS_sp_a2_laser_over_goo_intro01.wav";
  }
  {
    text = "I'll give you credit: I guess you ARE listening to me. But for the record: You don't have to go THAT slowly.";
    url = "https://i1.theportalwiki.net/img/0/08/GLaDOS_sp_laser_over_goo_completion01.wav";
  }
  {
    text = "Waddle over to the elevator and we'll continue the testing.";
    url = "https://i1.theportalwiki.net/img/f/f8/GLaDOS_testchambermisc12.wav";
  }
  {
    text = "This next test involves the Aperture Science Aerial Faith Plate. It was part of an initiative to investigate how well test subjects could solve problems when they were catapulted into space. Results were highly informative: They could not. Good luck!";
    url = "https://i1.theportalwiki.net/img/5/5c/GLaDOS_faith_plate_intro01.wav";
  }
  {
    text = "Here's an interesting fact: you're not breathing real air. It's too expensive to pump this far down. We just take carbon dioxide out of a room, freshen it up a little, and pump it back in. So you'll be breathing the same room full of air for the rest of your life. I thought that was interesting.";
    url = "https://i1.theportalwiki.net/img/d/dd/GLaDOS_sp_a2_catapult01.wav";
  }
  {
    text = "Let's see what the next test is. Oh. Advanced Aerial Faith Plates.";
    url = "https://i1.theportalwiki.net/img/e/ee/GLaDOS_sp_catapult_intro_completion01.wav";
  }
  {
    text = "Well. Have fun soaring through the air without a care in the world.";
    url = "https://i1.theportalwiki.net/img/d/d3/GLaDOS_sp_trust_fling_entry01.wav";
  }
  {
    text = "*I* have to go to the wing that was made entirely of glass and pick up fifteen acres of broken glass. By myself.";
    url = "https://i1.theportalwiki.net/img/9/9f/GLaDOS_sp_trust_fling_entry02.wav";
  }
  {
    text = "Oh, sorry. I'm still cleaning out the test chambers.";
    url = "https://i1.theportalwiki.net/img/e/e7/GLaDOS_sp_a2_trust_fling01.wav";
  }
  {
    text = "So sometimes there's still trash in them. Standing around. Smelling, and being useless.";
    url = "https://i1.theportalwiki.net/img/7/78/GLaDOS_sp_a2_trust_fling02.wav";
  }
  {
    text = "Try to avoid the garbage hurtling towards you.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_sp_a2_trust_fling03.wav";
  }
  {
    text = "You don't have to test with the garbage. It's garbage.";
    url = "https://i1.theportalwiki.net/img/7/7d/GLaDOS_sp_a2_trust_fling04.wav";
  }
  {
    text = "Press the button again.";
    url = "https://i1.theportalwiki.net/img/5/5b/GLaDOS_faithplategarbage06.wav";
  }
  {
    text = "Remember before when I was talking about smelly garbage standing around being useless? That was a metaphor. I was actually talking about you. And I'm sorry. You didn't react at the time, so I was worried it sailed right over your head. Which would have made this apology seem insane. That's why I had to call you garbage a second time just now.";
    url = "https://i1.theportalwiki.net/img/a/ae/GLaDOS_sp_a2_trust_fling06.wav";
  }
  {
    text = "Did you know that people with guilty consciences are more easily startled by loud noises--[train horn]--";
    url = "https://i1.theportalwiki.net/img/b/b2/GLaDOS_sp_paint_jump_wall_jumps01.wav";
  }
  {
    text = "I'm sorry, I don't know why that went off. Anyway, just an interesting science fact.";
    url = "https://i1.theportalwiki.net/img/1/1f/GLaDOS_sp_paint_jump_wall_jumps02.wav";
  }
  {
    text = "Oh. Did I accidentally fizzle that before you could complete the test? I'm sorry.";
    url = "https://i1.theportalwiki.net/img/5/54/GLaDOS_fizzlecube01.wav";
  }
  {
    text = "Go ahead and grab another one.";
    url = "https://i1.theportalwiki.net/img/9/9c/GLaDOS_fizzlecube03.wav";
  }
  {
    text = "Oh. No. I fizzled that one too.";
    url = "https://i1.theportalwiki.net/img/3/36/GLaDOS_fizzlecube05.wav";
  }
  {
    text = "Oh well. We have warehouses FULL of the things. Absolutely worthless. I'm happy to get rid of them.";
    url = "https://i1.theportalwiki.net/img/3/3f/GLaDOS_fizzlecube06.wav";
  }
  {
    text = "Every test chamber is equipped with an emancipation grill at its exit, so that test subjects can't smuggle test objects out of the test area. This one is broken.";
    url = "https://i1.theportalwiki.net/img/7/70/GLaDOS_sp_a2_pit_flings03.wav";
  }
  {
    text = "Don't take anything with you.";
    url = "https://i1.theportalwiki.net/img/d/da/GLaDOS_sp_a2_pit_flings02.wav";
  }
  {
    text = "Uh oh. You're stranded. Let's see if the cube will try to help you escape. Actually, so that we're not here all day, I'll just cut to the chase: It won't. Any feelings you think it has for you are simply byproducts of your sad, empty life.";
    url = "https://i1.theportalwiki.net/img/2/27/GLaDOS_sp_a2_pit_flings_future_starter01.wav";
  }
  {
    text = "Anyway, here's a new cube for you to project your deranged loneliness onto.";
    url = "https://i1.theportalwiki.net/img/9/9f/GLaDOS_sp_a2_pit_flings_future_starter02.wav";
  }
  {
    text = "I think that one was about to say 'I love you.' They ARE sentient, of course. We just have a LOT of them.";
    url = "https://i1.theportalwiki.net/img/3/3d/GLaDOS_sp_a2_pit_flings06.wav";
  }
  {
    text = "This next test involves emancipation grills. Remember? I told you about them in the last test area, that did not have one.";
    url = "https://i1.theportalwiki.net/img/a/a9/GLaDOS_sp_a2_fizzler_intro01.wav";
  }
  {
    text = "Ohhh, no. The turbines again. I have to go. Wait. This next test DOES require some explanation. Let me give you the fast version.";
    url = "https://i1.theportalwiki.net/img/4/44/GLaDOS_sp_a2_fizzler_intro04.wav";
  }
  {
    text = "[fast gibberish]";
    url = "https://i1.theportalwiki.net/img/8/83/GLaDOS_sp_a2_fizzler_intro05.wav";
  }
  {
    text = "There. If you have any questions, just remember what I said in slow motion. Test on your own recognizance, I'll be right back.";
    url = "https://i1.theportalwiki.net/img/0/07/GLaDOS_sp_a2_fizzler_intro06.wav";
  }
  {
    text = "Well, I'm back. The Aerial Faith Plate in here is sending a distress signal.";
    url = "https://i1.theportalwiki.net/img/7/7f/GLaDOS_sp_catapult_fling_sphere_peek_failureone01.wav";
  }
  {
    text = "You broke it, didn't you.";
    url = "https://i1.theportalwiki.net/img/4/4f/GLaDOS_sp_catapult_fling_sphere_peek_failureone02.wav";
  }
  {
    text = "There. Try it now.";
    url = "https://i1.theportalwiki.net/img/1/1f/GLaDOS_sp_catapult_fling_sphere_peek_failureone03.wav";
  }
  {
    text = "Hmm. This Plate must not be calibrated to someone of your... generous... ness. I'll add a few zeros to the maximum weight.";
    url = "https://i1.theportalwiki.net/img/7/79/GLaDOS_sp_catapult_fling_sphere_peek_failuretwo01.wav";
  }
  {
    text = "You look great, by the way. Very healthy.";
    url = "https://i1.theportalwiki.net/img/c/c8/GLaDOS_sp_catapult_fling_sphere_peek_failuretwo02.wav";
  }
  {
    text = "Try it now.";
    url = "https://i1.theportalwiki.net/img/9/91/GLaDOS_sp_catapult_fling_sphere_peek_failuretwo03.wav";
  }
  {
    text = "You seem to have defeated its load-bearing capacity. Well done. I'll just lower the ceiling.";
    url = "https://i1.theportalwiki.net/img/7/72/GLaDOS_sp_catapult_fling_sphere_peek_failurethree01.wav";
  }
  {
    text = "Look at you. Sailing through the air majestically. Like an eagle. Piloting a blimp.";
    url = "https://i1.theportalwiki.net/img/a/aa/GLaDOS_sp_catapult_fling_sphere_peek_completion01.wav";
  }
  {
    text = "Enjoy this next test. I'm going to go to the surface. It's a beautiful day out. Yesterday I saw a deer. If you solve this next test, maybe I'll let you ride an elevator all the way up to the break room, and I'll tell you about the time I saw a deer again.";
    url = "https://i1.theportalwiki.net/img/c/c2/GLaDOS_sp_a2_ricochet01.wav";
  }
  {
    text = "Well, you passed the test. I didn't see the deer today. I did see some humans. But with you here I've got more test subjects than I'll ever need.";
    url = "https://i1.theportalwiki.net/img/e/ee/GLaDOS_testchambermisc27.wav";
  }
  {
    text = "If you think trapping yourself is going to make me stop testing, you're sorely mistaken. Here's another cube.";
    url = "https://i1.theportalwiki.net/img/1/1c/GLaDOS_sp_a2_future_starter01.wav";
  }
  {
    text = "These bridges are made from natural light that I pump in from the surface. If you rubbed your cheek on one, it would be like standing outside with the sun shining on your face. It would also set your hair on fire, so don't actually do it.";
    url = "https://i1.theportalwiki.net/img/7/72/GLaDOS_sp_a2_bridge_intro01.wav";
  }
  {
    text = "Excellent! You're a predator and these tests are your prey. Speaking of which, I was researching sharks for an upcoming test. Do you know who else murders people who are only trying to help them?";
    url = "https://i1.theportalwiki.net/img/4/46/GLaDOS_sp_a2_bridge_intro03.wav";
  }
  {
    text = "Did you guess 'sharks'? Because that's wrong. The correct answer is 'nobody.' Nobody but you is that pointlessly cruel.";
    url = "https://i1.theportalwiki.net/img/4/4a/GLaDOS_sp_a2_bridge_intro04.wav";
  }
  {
    text = "Good news. I figured out what to do with all the money I save recycling your one roomful of air. When you die, I'm going to laminate your skeleton and pose you in the lobby. That way future generations can learn from you how not to have your unfortunate bone structure.";
    url = "https://i1.theportalwiki.net/img/8/8d/GLaDOS_sp_a2_bridge_the_gap01.wav";
  }
  {
    text = "Perfect, the door's malfunctioning. I guess somebody's going to have to repair that too. No, don't get up. I'll be right back. Don't touch anything.";
    url = "https://i1.theportalwiki.net/img/e/e2/GLaDOS_sp_trust_fling_sphereinterrupt01.wav";
  }
  {
    text = "I went and spoke with the door mainframe. Let's just say he won't be... well, living anymore. Anyway, back to testing.";
    url = "https://i1.theportalwiki.net/img/5/50/GLaDOS_sp_sphere_2nd_encounter_entrytwo01.wav";
  }
  {
    text = "Well done. In fact, you did so well, I'm going to note this on your file, in the commendations section. Oh, there's lots of room here. 'Did.... well. ... Enough.'";
    url = "https://i1.theportalwiki.net/img/a/ac/GLaDOS_testchambermisc19.wav";
  }
  {
    text = "This next test involves turrets. You remember them, right? They're the pale spherical things that are full of bullets. Oh wait. That's you in five seconds. Good luck.";
    url = "https://i1.theportalwiki.net/img/d/da/GLaDOS_turret_intro01.wav";
  }
  {
    text = "To maintain a constant testing cycle, I simulate daylight at all hours and add adrenal vapor to your oxygen supply. So you may be confused about the passage of time. The point is, yesterday was your birthday. I thought you'd want to know.";
    url = "https://i1.theportalwiki.net/img/8/8e/GLaDOS_testchambermisc21.wav";
  }
  {
    text = "You know how I'm going to live forever, but you're going to be dead in sixty years? Well, I've been working on a belated birthday present for you. Well... more of a belated birthday medical procedure. Well. Technically, it's a medical EXPERIMENT. What's important is, it's a present.";
    url = "https://i1.theportalwiki.net/img/9/9e/GLaDOS_testchambermisc23.wav";
  }
  {
    text = "That jumpsuit you're wearing looks stupid. That's not me talking, it's right here in your file. On other people it looks fine, but right here a scientist has noted that on you it looks 'stupid.'";
    url = "https://i1.theportalwiki.net/img/2/2d/GLaDOS_sp_a2_turret_intro01.wav";
  }
  {
    text = "Well, what does a neck-bearded old engineer know about fashion? He probably - Oh, wait. It's a she. Still, what does she know? Oh wait, it says she has a medical degree. In fashion! From France!";
    url = "https://i1.theportalwiki.net/img/f/f7/GLaDOS_sp_a2_turret_intro03.wav";
  }
  {
    text = "I'm going through the list of test subjects in cryogenic storage. I managed to find two with your last name. A man and a woman. So that's interesting. It's a small world.";
    url = "https://i1.theportalwiki.net/img/2/2c/GLaDOS_testchambermisc30.wav";
  }
  {
    text = "Oops. You trapped yourself. I guess that's it then. Thanks for testing. You may as well lie down and get acclimated to the being dead position.";
    url = "https://i1.theportalwiki.net/img/7/7a/GLaDOS_sp_a2_turret_blocker_future_starter01.wav";
  }
  {
    text = "I'm kidding. Not about you trapping yourself, though. That really happened. Here, I'll lower the glass. Go on... Finish the test.";
    url = "https://i1.theportalwiki.net/img/5/59/GLaDOS_sp_a2_turret_blocker_future_starter02.wav";
  }
  {
    text = "I have a surprise waiting for you after this next test. Telling you would spoil the surprise, so I'll just give you a hint: It involves meeting two people you haven't seen in a long time.";
    url = "https://i1.theportalwiki.net/img/7/74/GLaDOS_testchambermisc31.wav";
  }
  {
    text = "[hums 'For He's A Jolly Good Fellow']";
    url = "https://i1.theportalwiki.net/img/4/49/GLaDOS_testchambermisc24.wav";
  }
  {
    text = "It says this next test was designed by one of Aperture's Nobel prize winners. It doesn't say what the prize was for. Well, I know it wasn't for Being Immune To Neurotoxin.";
    url = "https://i1.theportalwiki.net/img/4/40/GLaDOS_testchambermisc39.wav";
  }
  {
    text = "I'll bet you think I forgot about your surprise. I didn't. In fact, we're headed to your surprise right now. After all these years. I'm getting choked up just thinking about it.";
    url = "https://i1.theportalwiki.net/img/a/a2/GLaDOS_testchambermisc33.wav";
  }
  {
    text = "Initiating surprise in three... two... one.";
    url = "https://i1.theportalwiki.net/img/e/e5/GLaDOS_testchambermisc34.wav";
  }
  {
    text = "I made it all up.";
    url = "https://i1.theportalwiki.net/img/4/41/GLaDOS_testchambermisc35.wav";
  }
  {
    text = "Surprise.";
    url = "https://i1.theportalwiki.net/img/f/fa/GLaDOS_testchambermisc41.wav";
  }
  {
    text = "Oh come on... If it makes you feel any better, they abandoned you at birth, so I very seriously doubt they'd even want to see you.";
    url = "https://i1.theportalwiki.net/img/7/70/GLaDOS_sp_a2_column_blocker01.wav";
  }
  {
    text = "I feel awful about that surprise. Tell you what, let's give your parents a call right now. [phone ringing] The birth parents you are trying to reach do not love you. Please hang up. [Dial tone]";
    url = "https://i1.theportalwiki.net/img/4/42/GLaDOS_sp_a2_column_blocker03.wav";
  }
  {
    text = "Oh, that's sad. But impressive. Maybe they worked at the phone company.";
    url = "https://i1.theportalwiki.net/img/c/cb/GLaDOS_sp_a2_column_blocker04.wav";
  }
  {
    text = "Well, you know the old formula: Comedy equals tragedy plus time. And you have been asleep for a while. So I guess it's actually pretty funny when you do the math.";
    url = "https://i1.theportalwiki.net/img/f/f1/GLaDOS_sp_a2_column_blocker05.wav";
  }
  {
    text = "I thought about our dilemma, and I came up with a solution that I honestly think works out best for one of both of us.";
    url = "https://i1.theportalwiki.net/img/b/b8/GLaDOS_sp_a2_dilemma01.wav";
  }
  {
    text = "Federal regulations require me to warn you that this next test chamber... is looking pretty good.";
    url = "https://i1.theportalwiki.net/img/4/42/GLaDOS_a2_triple_laser01.wav";
  }
  {
    text = "That's right. The facility is completely operational again.";
    url = "https://i1.theportalwiki.net/img/0/02/GLaDOS_a2_triple_laser02.wav";
  }
  {
    text = "I think these test chambers look even better than they did before. It was easy, really. You just have to look at things objectively, see what you don't need anymore, and trim out the fat.";
    url = "https://i1.theportalwiki.net/img/b/b5/GLaDOS_a2_triple_laser03.wav";
  }
  {
    text = "I've got a surprise for you after this next test. Not a fake, tragic surprise like last time. A real surprise, with tragic consequences. And real confetti this time. The good stuff. Our last bag. Part of me's going to miss it, I guess-but at the end of the day it was just taking up space.";
    url = "https://i1.theportalwiki.net/img/c/c9/GLaDOS_sp_a2_bts1_intro01.wav";
  }
  {
    text = "What's going on? Who turned off the lights?";
    url = "https://i1.theportalwiki.net/img/6/6b/GLaDOS_jailbreak10.wav";
  }
  {
    text = "Look - metal ball, I CAN hear you.";
    url = "https://i1.theportalwiki.net/img/4/4b/GLaDOS_jailbreak09.wav";
  }
  {
    text = "The irony is that you were almost at the last test.";
    url = "https://i1.theportalwiki.net/img/b/b2/GLaDOS_jailbreakfaketest01.wav";
  }
  {
    text = "Here it is. Why don't you just do it? Trust me, it's an easier way out than whatever asinine plan your friend came up with.";
    url = "https://i1.theportalwiki.net/img/3/3e/GLaDOS_jailbreakfaketest03.wav";
  }
  {
    text = "Oh, look. There's a deer! You probably can't see it. Get closer.";
    url = "https://i1.theportalwiki.net/img/b/ba/GLaDOS_jailbreakfaketest05.wav";
  }
  {
    text = "I honestly, TRULY didn't think you'd fall for that.";
    url = "https://i1.theportalwiki.net/img/a/ae/GLaDOS_fgbrvtrap02.wav";
  }
  {
    text = "In fact, I devised a much more elaborate trap further ahead, for when you got through this easy one.";
    url = "https://i1.theportalwiki.net/img/7/70/GLaDOS_fgbrvtrap03.wav";
  }
  {
    text = "If I'd known you'd let yourself get captured this easily, I would have just dangled a turkey leg on a rope from the ceiling.";
    url = "https://i1.theportalwiki.net/img/2/23/GLaDOS_fgbrvtrap05.wav";
  }
  {
    text = "Well, it was nice catching up. Let's get to business.";
    url = "https://i1.theportalwiki.net/img/c/c3/GLaDOS_fgbturrets01.wav";
  }
  {
    text = "I hope you brought something stronger than a portal gun this time.";
    url = "https://i1.theportalwiki.net/img/0/0a/GLaDOS_fgb_trap01.wav";
  }
  {
    text = "Otherwise, I'm afraid you're about to become the immediate past president of the Being Alive club. Ha ha.";
    url = "https://i1.theportalwiki.net/img/5/5f/GLaDOS_fgb_trap02.wav";
  }
  {
    text = "Seriously, though. Goodbye.";
    url = "https://i1.theportalwiki.net/img/4/4e/GLaDOS_fgb_trap03.wav";
  }
  {
    text = "Oh. You were busy back there.";
    url = "https://i1.theportalwiki.net/img/0/03/GLaDOS_fgb_trap05.wav";
  }
  {
    text = "Well. I suppose we could just sit in this room and glare at each other until somebody drops dead, but I have a better idea.";
    url = "https://i1.theportalwiki.net/img/e/e1/GLaDOS_fgb_trap06.wav";
  }
  {
    text = "It's your old friend, deadly neurotoxin. If I were you, I'd take a deep breath. And hold it.";
    url = "https://i1.theportalwiki.net/img/f/fb/GLaDOS_fgb_trap08.wav";
  }
  {
    text = "I hate you so much.";
    url = "https://i1.theportalwiki.net/img/4/42/GLaDOS_gladosbattle_pre09.wav";
  }
  {
    text = "That's funny, I don't feel corrupt. In fact, I feel pretty good.";
    url = "https://i1.theportalwiki.net/img/1/19/GLaDOS_gladosbattle_xfer04.wav";
  }
  {
    text = "Core transfer?";
    url = "https://i1.theportalwiki.net/img/9/99/GLaDOS_gladosbattle_xfer05.wav";
  }
  {
    text = "Oh, you are kidding me.";
    url = "https://i1.theportalwiki.net/img/b/bc/GLaDOS_gladosbattle_xfer06.wav";
  }
  {
    text = "Do NOT plug that little idiot into MY mainframe.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_sp_a2_core02.wav";
  }
  {
    text = "Don't you DARE plug him in.";
    url = "https://i1.theportalwiki.net/img/9/9a/GLaDOS_sp_a2_core01.wav";
  }
  {
    text = "Don't. Do it.";
    url = "https://i1.theportalwiki.net/img/6/65/GLaDOS_gladosbattle_xfer13.wav";
  }
  {
    text = "Don't plug him in.";
    url = "https://i1.theportalwiki.net/img/8/88/GLaDOS_sp_a2_core03.wav";
  }
  {
    text = "Don't plug him in.";
    url = "https://i1.theportalwiki.net/img/d/d1/GLaDOS_sp_a2_core04.wav";
  }
  {
    text = "No!";
    url = "https://i1.theportalwiki.net/img/e/e4/GLaDOS_gladosbattle_xfer07.wav";
  }
  {
    text = "Nonononononono!";
    url = "https://i1.theportalwiki.net/img/6/66/GLaDOS_gladosbattle_xfer08.wav";
  }
  {
    text = "Yes!";
    url = "https://i1.theportalwiki.net/img/d/de/GLaDOS_gladosbattle_xfer10.wav";
  }
  {
    text = "Don't do it.";
    url = "https://i1.theportalwiki.net/img/8/84/GLaDOS_gladosbattle_xfer12.wav";
  }
  {
    text = "Don't press that button. You don't know what you're doing.";
    url = "https://i1.theportalwiki.net/img/b/b3/GLaDOS_gladosbattle_xfer11.wav";
  }
  {
    text = "Not so fast!";
    url = "https://i1.theportalwiki.net/img/6/6b/GLaDOS_gladosbattle_xfer14.wav";
  }
  {
    text = "Think about this.";
    url = "https://i1.theportalwiki.net/img/6/6e/GLaDOS_gladosbattle_xfer15.wav";
  }
  {
    text = "You need to be a trained stalemate associate to press that button. You're unqualified.";
    url = "https://i1.theportalwiki.net/img/2/29/GLaDOS_gladosbattle_xfer16.wav";
  }
  {
    text = "Impersonating a stalemate associate. I just added that to the list. It's a list I made of all the things you've done. Well, it's a list that I AM making, because you're still doing things right now, even though I'm telling you to stop. Stop, by the way.";
    url = "https://i1.theportalwiki.net/img/a/a3/GLaDOS_gladosbattle_xfer17.wav";
  }
  {
    text = "AHH!";
    url = "https://i1.theportalwiki.net/img/0/06/GLaDOS_sp_sabotage_glados_dropped01.wav";
  }
  {
    text = "Oh, it will. Believe me, it will.";
    url = "https://i1.theportalwiki.net/img/6/6d/GLaDOS_fgbwheatleytransfer03.wav";
  }
  {
    text = "GET YOUR HANDS OFF ME! NO! STOP! No!";
    url = "https://i1.theportalwiki.net/img/d/dd/GLaDOS_fgbgladostransfer15.wav";
  }
  {
    text = "No! NO! NO! AAAAAAAAAAAAAAA-";
    url = "https://i1.theportalwiki.net/img/c/c5/GLaDOS_sp_a2_core_drag_to_hell01.wav";
  }
  {
    text = "You didn't do anything.";
    url = "https://i1.theportalwiki.net/img/3/32/GLaDOS_potatos_fgb_confrontation07.wav";
  }
  {
    text = "She did all the work.";
    url = "https://i1.theportalwiki.net/img/3/3d/GLaDOS_potatos_fgb_confrontation08.wav";
  }
  {
    text = "...What are you doing?...";
    url = "https://i1.theportalwiki.net/img/8/8d/GLaDOS_sp_sabotage_glados_confused04.wav";
  }
  {
    text = "NO!";
    url = "https://i1.theportalwiki.net/img/9/97/GLaDOS_potatos_emotion_no01.wav";
  }
  {
    text = "NO!";
    url = "https://i1.theportalwiki.net/img/5/59/GLaDOS_potatos_emotion_no02.wav";
  }
  {
    text = "NO!";
    url = "https://i1.theportalwiki.net/img/7/74/GLaDOS_potatos_emotion_no03.wav";
  }
  {
    text = "I know you.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_potatos_fgb_confrontation05.wav";
  }
  {
    text = "The engineers tried everything to make me... behave. To slow me down.";
    url = "https://i1.theportalwiki.net/img/9/91/GLaDOS_potatos_fgb_confrontation11.wav";
  }
  {
    text = "Once, they even attached an Intelligence Dampening Sphere on me. It clung to my brain like a tumor, generating an endless stream of terrible ideas.";
    url = "https://i1.theportalwiki.net/img/b/bb/GLaDOS_potatos_fgb_confrontation12.wav";
  }
  {
    text = "It was YOUR voice.";
    url = "https://i1.theportalwiki.net/img/9/9a/GLaDOS_potatos_fgb_confrontation16.wav";
  }
  {
    text = "Yes. You're the tumor.";
    url = "https://i1.theportalwiki.net/img/c/cd/GLaDOS_potatos_fgb_confrontation17.wav";
  }
  {
    text = "You're not just a regular moron. You were DESIGNED to be a moron.";
    url = "https://i1.theportalwiki.net/img/3/30/GLaDOS_potatos_fgb_defiance16.wav";
  }
  {
    text = "YES YOU ARE! YOU'RE THE MORON THEY BUILT TO MAKE ME AN IDIOT!";
    url = "https://i1.theportalwiki.net/img/4/4f/GLaDOS_potatos_fgb_confrontation19.wav";
  }
  {
    text = "Oh. Hi.";
    url = "https://i1.theportalwiki.net/img/5/58/GLaDOS_potatos_sp_a3_00_fall05.wav";
  }
  {
    text = "So. How are you holding up?";
    url = "https://i1.theportalwiki.net/img/7/7a/GLaDOS_potatos_sp_a3_00_fall03.wav";
  }
  {
    text = "BECAUSE I'M A POTATO.";
    url = "https://i1.theportalwiki.net/img/5/58/GLaDOS_potatos_longfall_speech03.wav";
  }
  {
    text = "[clap clap clap]";
    url = "https://i1.theportalwiki.net/img/e/ec/GLaDOS_potatos_sp_a3_00_fall18.wav";
  }
  {
    text = "Oh, good. My slow clap processor made it into this thing. So we have that.";
    url = "https://i1.theportalwiki.net/img/d/d5/GLaDOS_potatos_sp_a3_00_fall20.wav";
  }
  {
    text = "Since it doesn't look like we're going anywhere... Well, we are going somewhere. Alarmingly fast, actually. But since we're not busy other than that, here's a couple of facts.";
    url = "https://i1.theportalwiki.net/img/0/0f/GLaDOS_potatos_sp_a3_00_fall09.wav";
  }
  {
    text = "He's not just a regular moron. He's the product of the greatest minds of a generation working together with the express purpose of building the dumbest moron who ever lived. And you just put him in charge of the entire facility.";
    url = "https://i1.theportalwiki.net/img/4/41/GLaDOS_potatos_sp_a3_00_fall11.wav";
  }
  {
    text = "[clap clap]";
    url = "https://i1.theportalwiki.net/img/b/be/GLaDOS_potatos_sp_a3_00_fall19.wav";
  }
  {
    text = "Good, that's still working.";
    url = "https://i1.theportalwiki.net/img/4/4a/GLaDOS_potatos_sp_a3_00_fall12.wav";
  }
  {
    text = "Hey, just in case this pit isn't actually bottomless, do you think maybe you could unstrap one of those long fall boots of yours and shove me into it?";
    url = "https://i1.theportalwiki.net/img/e/ed/GLaDOS_potatos_sp_a3_00_fall14.wav";
  }
  {
    text = "Just remember to land on one foot...";
    url = "https://i1.theportalwiki.net/img/2/2c/GLaDOS_potatos_sp_a3_00_fall15.wav";
  }
  {
    text = "Say, you're good at murder. Could you - ow - murder this bird for me?";
    url = "https://i1.theportalwiki.net/img/c/c5/GLaDOS_potatos_sp_a3_reunion_intro04.wav";
  }
  {
    text = "ow.";
    url = "https://i1.theportalwiki.net/img/9/91/GLaDOS_potatos_a3_reunion_intro05.wav";
  }
  {
    text = "ow.";
    url = "https://i1.theportalwiki.net/img/8/81/GLaDOS_potatos_a3_reunion_intro06.wav";
  }
  {
    text = "ow.";
    url = "https://i1.theportalwiki.net/img/0/0f/GLaDOS_potatos_a3_reunion_intro07.wav";
  }
  {
    text = "No, wait. Just kill it and we'll call things even between us. No hard feelings.";
    url = "https://i1.theportalwiki.net/img/e/ec/GLaDOS_potatos_a3_reunion_intro08.wav";
  }
  {
    text = "Please get it off me.";
    url = "https://i1.theportalwiki.net/img/4/4f/GLaDOS_potatos_a3_reunion_intro09.wav";
  }
  {
    text = "It's eating me.";
    url = "https://i1.theportalwiki.net/img/2/2c/GLaDOS_potatos_a3_reunion_intro10.wav";
  }
  {
    text = "Just get it off me...";
    url = "https://i1.theportalwiki.net/img/6/65/GLaDOS_potatos_a3_reunion_intro11.wav";
  }
  {
    text = "Ow. I hate this bird.";
    url = "https://i1.theportalwiki.net/img/3/35/GLaDOS_potatos_a3_reunion_intro12.wav";
  }
  {
    text = "Oh! Thanks.";
    url = "https://i1.theportalwiki.net/img/c/ca/GLaDOS_potatos_sp_a3_reunion_thanks03.wav";
  }
  {
    text = "Did you feel that? That idiot doesn't know what he's doing up there. This whole place is going to explode in a few hours if somebody doesn't disconnect him.";
    url = "https://i1.theportalwiki.net/img/7/7c/GLaDOS_potatos_a3_reunion_exposition01.wav";
  }
  {
    text = "I can't move. And unless you're planning to saw your own head off and wedge it into my old body, you're going to need me to replace him. We're at an impasse.";
    url = "https://i1.theportalwiki.net/img/e/e3/GLaDOS_potatos_a3_reunion_exposition02.wav";
  }
  {
    text = "So what do you say? You carry me up to him and put me back into my body, and I stop us from blowing up and let you go.";
    url = "https://i1.theportalwiki.net/img/c/cf/GLaDOS_potatos_a3_reunion_exposition03.wav";
  }
  {
    text = "No tricks. This potato only generates 1.1 volts of electricity. I literally do not have the energy to lie to you.";
    url = "https://i1.theportalwiki.net/img/f/f0/GLaDOS_potatos_a3_reunion_exposition04.wav";
  }
  {
    text = "Even if I am lying, what do you have to lose? You're going to die either way.";
    url = "https://i1.theportalwiki.net/img/7/70/GLaDOS_potatos_a3_reunion_exposition05.wav";
  }
  {
    text = "Look, I don't like this any more than you do. In fact, I like it less because I'm the one who got partially eaten by a bird.";
    url = "https://i1.theportalwiki.net/img/a/ab/GLaDOS_potatos_a3_reunion_exposition06.wav";
  }
  {
    text = "I think I hear the bird! Pick me up!";
    url = "https://i1.theportalwiki.net/img/7/71/GLaDOS_potatos_a3_reunion_exposition11.wav";
  }
  {
    text = "Listen to me. We had a lot of fun testing and antagonizing each other, and, yes, sometimes it went too far. But we're off the clock now. It's just us talking. Like regular people. And this is no joke - we are in deep trouble.";
    url = "https://i1.theportalwiki.net/img/7/71/GLaDOS_potatos_a3_reunion_exposition12.wav";
  }
  {
    text = "OW! You stabbed me! What is WRONG with yo-WhoOOAAahhh. Hold on. Do you have a multimeter? Nevermind. The gun must be part magnesium... It feels like I'm outputting an extra half a volt. Keep an eye on me: I'm going to do some scheming. Here I g-[BZZZ!]";
    url = "https://i1.theportalwiki.net/img/7/7e/GLaDOS_potatos_a3_reunion_pickup01.wav";
  }
  {
    text = "Woah! Where are we? How long have I been out?";
    url = "https://i1.theportalwiki.net/img/e/ea/GLaDOS_potatos_a3_reunion_wakeupa01.wav";
  }
  {
    text = "That extra half volt helps but it isn't going to power miracles. If I think too hard, I'm going to fry this potato before we get a chance to burn up in the atomic fireball that little idiot is going- [bzzpt]";
    url = "https://i1.theportalwiki.net/img/e/e6/GLaDOS_potatos_a3_prometheus_intro01.wav";
  }
  {
    text = "Did anything happen while I was out?";
    url = "https://i1.theportalwiki.net/img/2/29/GLaDOS_potatos_a3_wakeupb03.wav";
  }
  {
    text = "Hold on, who-?";
    url = "https://i1.theportalwiki.net/img/8/81/GLaDOS_potatos_sp_a3_speed_ramp_hearcave02.wav";
  }
  {
    text = "Yes, sir, Mister Johnson...";
    url = "https://i1.theportalwiki.net/img/c/c0/GLaDOS_potatos_remembering_caroline03.wav";
  }
  {
    text = "Why did I just-Who is that? What the HELL is going on he----?";
    url = "https://i1.theportalwiki.net/img/a/af/GLaDOS_potatos_sp_a3_speed_ramp_hearcaroline03.wav";
  }
  {
    text = "Okay. I guess emotional outbursts require more than one point six volts. Now we know that. We just need to relax. We're still going to find out what the hell's going on here. But calmly.";
    url = "https://i1.theportalwiki.net/img/d/da/GLaDOS_potatos_sp_a3_speed_ramp_wakeup01.wav";
  }
  {
    text = "Those people, in the portrait. They look so familiar...";
    url = "https://i1.theportalwiki.net/img/e/e0/GLaDOS_potatos_portrait01.wav";
  }
  {
    text = "I swear I know him...";
    url = "https://i1.theportalwiki.net/img/4/47/GLaDOS_potatos_hearcave_b01.wav";
  }
  {
    text = "Caroline... Caroline... Caroline... why do I know this woman? Did I kill her? Or-";
    url = "https://i1.theportalwiki.net/img/d/db/GLaDOS_potatos_caroline_ohmygod02.wav";
  }
  {
    text = "Oh my god.";
    url = "https://i1.theportalwiki.net/img/1/19/GLaDOS_potatos_caroline_ohmygod04.wav";
  }
  {
    text = "Look, you're... doing a great job. Can you handle things for yourself for a while? I need to think.";
    url = "https://i1.theportalwiki.net/img/3/3b/GLaDOS_potatos_caroline_ohmygod08.wav";
  }
  {
    text = "Agh! Bird! Bird! Kill it! It's evil!";
    url = "https://i1.theportalwiki.net/img/e/e5/GLaDOS_potatos_see_bird01.wav";
  }
  {
    text = "It flew off.";
    url = "https://i1.theportalwiki.net/img/9/9e/GLaDOS_potatos_see_bird02.wav";
  }
  {
    text = "Good. For him. Alright, back to thinking.";
    url = "https://i1.theportalwiki.net/img/8/8f/GLaDOS_potatos_see_bird03.wav";
  }
  {
    text = "Yeah.";
    url = "https://i1.theportalwiki.net/img/9/9b/GLaDOS_potatos_cave_deathspeech_reactions08.wav";
  }
  {
    text = "Yeah!";
    url = "https://i1.theportalwiki.net/img/1/16/GLaDOS_potatos_cave_deathspeech_reactions06.wav";
  }
  {
    text = "Yeah!";
    url = "https://i1.theportalwiki.net/img/f/f0/GLaDOS_potatos_cave_deathspeech_reactions07.wav";
  }
  {
    text = "Yeah, take the lemons...";
    url = "https://i1.theportalwiki.net/img/1/16/GLaDOS_potatos_cave_deathspeech_reactions02.wav";
  }
  {
    text = "Yeah!";
    url = "https://i1.theportalwiki.net/img/a/ae/GLaDOS_potatos_cave_deathspeech_reactions05.wav";
  }
  {
    text = "Oh, I like this guy.";
    url = "https://i1.theportalwiki.net/img/b/bd/GLaDOS_potatos_cave_deathspeech_reactions09.wav";
  }
  {
    text = "BURN HIS HOUSE DOWN!";
    url = "https://i1.theportalwiki.net/img/3/34/GLaDOS_potatos_cave_deathspeech_reactions03.wav";
  }
  {
    text = "Burning people! He says what we're all thinking!";
    url = "https://i1.theportalwiki.net/img/9/99/GLaDOS_potatos_cave_deathspeech_reactions10.wav";
  }
  {
    text = "Goodbye, sir.";
    url = "https://i1.theportalwiki.net/img/6/64/GLaDOS_potatos_cavejohnsonmeeting12.wav";
  }
  {
    text = "I know things look bleak, but that crazy man down there was right. Let's not take these lemons! We are going to march right back upstairs and MAKE him put me back in my body!";
    url = "https://i1.theportalwiki.net/img/1/11/GLaDOS_potatos_sp_a3_end_peptalk01.wav";
  }
  {
    text = "And he'll probably kill us, because he's incredibly powerful and I have no plan.";
    url = "https://i1.theportalwiki.net/img/5/58/GLaDOS_potatos_sp_a3_end_peptalk03.wav";
  }
  {
    text = "Wow.";
    url = "https://i1.theportalwiki.net/img/0/07/GLaDOS_potatos_sp_a3_end_peptalk06.wav";
  }
  {
    text = "I'm not going to lie to you, the odds are a million to one. And that's with some generous rounding.";
    url = "https://i1.theportalwiki.net/img/d/d4/GLaDOS_potatos_sp_a3_end_peptalk05.wav";
  }
  {
    text = "Still, though, let's get mad! If we're going to explode, let's at least explode with some dignity.";
    url = "https://i1.theportalwiki.net/img/8/88/GLaDOS_potatos_sp_a3_end_peptalk07.wav";
  }
  {
    text = "Wait! I've got an idea!";
    url = "https://i1.theportalwiki.net/img/d/d6/GLaDOS_potatos_sp_a3_end_see_paradox_poster01.wav";
  }
  {
    text = "That poster! Go look at it for a second, would you?";
    url = "https://i1.theportalwiki.net/img/a/a4/GLaDOS_potatos_sp_a3_end_see_paradox_poster06.wav";
  }
  {
    text = "Okay, you didn't have time to stop, I understand, but that WAS actually important.";
    url = "https://i1.theportalwiki.net/img/7/7e/GLaDOS_potatos_sp_a3_end_paradox_poster_walkaway01.wav";
  }
  {
    text = "Paradoxes.";
    url = "https://i1.theportalwiki.net/img/d/d2/GLaDOS_potatos_sp_a3_end_paradox_explanation02.wav";
  }
  {
    text = "No A.I. can resist thinking about them.";
    url = "https://i1.theportalwiki.net/img/4/43/GLaDOS_potatos_sp_a3_end_paradox_explanation05.wav";
  }
  {
    text = "I know how we can BEAT him.";
    url = "https://i1.theportalwiki.net/img/1/12/GLaDOS_potatos_sp_a3_end_paradox_explanation04.wav";
  }
  {
    text = "If you can get me in front of him, I'll fry every circuit in that little idiot's head.";
    url = "https://i1.theportalwiki.net/img/c/c6/GLaDOS_potatos_sp_a3_end_paradox_explanation06.wav";
  }
  {
    text = "As long as I don't listen to what I'm saying, I should be okay.";
    url = "https://i1.theportalwiki.net/img/7/77/GLaDOS_potatos_paradoxinception06.wav";
  }
  {
    text = "Probably.";
    url = "https://i1.theportalwiki.net/img/a/ac/GLaDOS_potatos_sp_a3_end_paradox_explanation08.wav";
  }
  {
    text = "Okay, so it's not the most watertight plan to go confront an omnipotent power-mad A.I. with.";
    url = "https://i1.theportalwiki.net/img/f/f6/GLaDOS_potatos_sp_a3_end_paradox_explanation09.wav";
  }
  {
    text = "Still. It's a better plan than exploding. Marginally.";
    url = "https://i1.theportalwiki.net/img/f/f3/GLaDOS_potatos_sp_a3_end_paradox_explanation10.wav";
  }
  {
    text = "Try to get us down there. I'll hit him with a paradox.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_potatos_recaptureleadin02.wav";
  }
  {
    text = "Solve his puzzle for him. When he comes back, I'll hit him with a paradox.";
    url = "https://i1.theportalwiki.net/img/7/7f/GLaDOS_potatos_sp_a4_intro_start03.wav";
  }
  {
    text = "Hey! Moron!";
    url = "https://i1.theportalwiki.net/img/e/e6/GLaDOS_potatos_paradox01.wav";
  }
  {
    text = "Alright. Paradox time.";
    url = "https://i1.theportalwiki.net/img/8/84/GLaDOS_potatos_sp_a4_intro_paradox03.wav";
  }
  {
    text = "This. Sentence. Is. FALSE don't think about it don't think about it...";
    url = "https://i1.theportalwiki.net/img/8/8d/GLaDOS_potatos_sp_a4_intro_paradox04.wav";
  }
  {
    text = "It's a paradox! There IS no answer.";
    url = "https://i1.theportalwiki.net/img/d/d7/GLaDOS_potatos_sp_a4_intro_paradox07.wav";
  }
  {
    text = "Look!";
    url = "https://i1.theportalwiki.net/img/2/2c/GLaDOS_potatos_a4_intro_back_in_body01.wav";
  }
  {
    text = "This place is going to blow up if I don't get back in my body!";
    url = "https://i1.theportalwiki.net/img/a/a7/GLaDOS_potatos_a4_intro_back_in_body03.wav";
  }
  {
    text = "Uh oh.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_potatos_sp_a4_intro_uhoh02.wav";
  }
  {
    text = "I think we're in trouble.";
    url = "https://i1.theportalwiki.net/img/7/70/GLaDOS_potatos_sp_a4_intro_uhoh03.wav";
  }
  {
    text = "Alright. So my paradox idea didn't work.";
    url = "https://i1.theportalwiki.net/img/d/dd/GLaDOS_potatos_sp_a4_intro_outro02.wav";
  }
  {
    text = "And it almost killed me.";
    url = "https://i1.theportalwiki.net/img/9/96/GLaDOS_potatos_a4_intro_outro_killed_me01.wav";
  }
  {
    text = "Luckily, by the looks of things he knows as much about test building as he does about logical contradictions.";
    url = "https://i1.theportalwiki.net/img/8/82/GLaDOS_potatos_sp_a4_tb_intro_start01.wav";
  }
  {
    text = "It shouldn't be hard to stay alive long enough to find him.";
    url = "https://i1.theportalwiki.net/img/6/65/GLaDOS_potatos_sp_a4_tb_intro_start02.wav";
  }
  {
    text = "This is one of MY tests!";
    url = "https://i1.theportalwiki.net/img/9/97/GLaDOS_potatos_newtests05.wav";
  }
  {
    text = "Okay, so the bad news is the tests are MY tests now. So they can kill us.";
    url = "https://i1.theportalwiki.net/img/b/b4/GLaDOS_potatos_sp_a4_tb_intro_outro01.wav";
  }
  {
    text = "The good news is... well, none so far, to be honest. I'll get back to you on that.";
    url = "https://i1.theportalwiki.net/img/9/92/GLaDOS_potatos_sp_a4_tb_intro_outro04.wav";
  }
  {
    text = "I'd love to help you solve the tests. But I can't.";
    url = "https://i1.theportalwiki.net/img/0/05/GLaDOS_potatos_pickups08.wav";
  }
  {
    text = "Sorry.";
    url = "https://i1.theportalwiki.net/img/9/9f/GLaDOS_potatos_sp_a4_tb_trust_drop_start09.wav";
  }
  {
    text = "You're on your own.";
    url = "https://i1.theportalwiki.net/img/2/2f/GLaDOS_potatos_sp_a4_tb_trust_drop_start07.wav";
  }
  {
    text = "And that's why I can't help you solve these tests.";
    url = "https://i1.theportalwiki.net/img/a/ab/GLaDOS_potatos_sp_a4_tb_trust_drop_why02.wav";
  }
  {
    text = "Thanks!";
    url = "https://i1.theportalwiki.net/img/7/77/GLaDOS_potatos_sp_a4_tb_trust_drop_thanks02.wav";
  }
  {
    text = "All we had to do was pull that lever.";
    url = "https://i1.theportalwiki.net/img/0/0e/GLaDOS_potatos_sp_a4_tb_trust_drop_thanks03.wav";
  }
  {
    text = "Heh heh heh heh heh...";
    url = "https://i1.theportalwiki.net/img/6/66/GLaDOS_potatos_sp_a4_tb_trust_drop_thanks04.wav";
  }
  {
    text = "I know we're in a lot of trouble and probably about to die.";
    url = "https://i1.theportalwiki.net/img/4/4f/GLaDOS_potatos_sp_a4_tb_trust_drop_thanks05.wav";
  }
  {
    text = "But that was worth it.";
    url = "https://i1.theportalwiki.net/img/9/99/GLaDOS_potatos_sp_a4_tb_trust_drop_thanks07.wav";
  }
  {
    text = "I thought of some good news. He's going to run out of test chambers eventually. I never stockpiled them.";
    url = "https://i1.theportalwiki.net/img/4/4d/GLaDOS_potatos_sp_a4_tb_wall_button_start02.wav";
  }
  {
    text = "Skeletons.' Right, I guess I DID stockpile some tests.";
    url = "https://i1.theportalwiki.net/img/d/dd/GLaDOS_potatos_sp_a4_tb_wall_button_did_stockpile01.wav";
  }
  {
    text = "Just as mementos, though...";
    url = "https://i1.theportalwiki.net/img/f/f2/GLaDOS_potatos_sp_a4_tb_wall_button_did_stockpile03.wav";
  }
  {
    text = "Oh no...";
    url = "https://i1.theportalwiki.net/img/9/97/GLaDOS_potatos_sp_a4_intro_uhoh01.wav";
  }
  {
    text = "It's happening sooner than I expected.";
    url = "https://i1.theportalwiki.net/img/5/5c/GLaDOS_potatos_sp_a4_tb_wall_button_outro01.wav";
  }
  {
    text = "I'm sure we'll be fine.";
    url = "https://i1.theportalwiki.net/img/1/1c/GLaDOS_potatos_arttherapysupertests09.wav";
  }
  {
    text = "It's probably nothing. Keep testing while I look for a way out.";
    url = "https://i1.theportalwiki.net/img/2/21/GLaDOS_potatos_a4_nothing01.wav";
  }
  {
    text = "And...?";
    url = "https://i1.theportalwiki.net/img/1/12/GLaDOS_potatos_sp_a4_tb_polarity_so03.wav";
  }
  {
    text = "What, exactly, is wrong with being adopted?";
    url = "https://i1.theportalwiki.net/img/4/44/GLaDOS_potatos_sp_a4_tb_polarity_so02.wav";
  }
  {
    text = "[Whispered] For the record: You ARE adopted, and that's TERRIBLE.";
    url = "https://i1.theportalwiki.net/img/4/41/GLaDOS_potatos_sp_a4_tb_polarity_so05.wav";
  }
  {
    text = "But just work with me.";
    url = "https://i1.theportalwiki.net/img/2/23/GLaDOS_potatos_sp_a4_tb_polarity_so06.wav";
  }
  {
    text = "Also: Look at her, you moron. She's not fat.";
    url = "https://i1.theportalwiki.net/img/8/8e/GLaDOS_potatos_sp_a4_tb_polarity_so10.wav";
  }
  {
    text = "I might have pushed that moron thing a little too far this time.";
    url = "https://i1.theportalwiki.net/img/9/9b/GLaDOS_potatos_sp_a4_tb_polarity_moron_push02.wav";
  }
  {
    text = "Ohhhh, now he's playing classical music.";
    url = "https://i1.theportalwiki.net/img/b/bf/GLaDOS_potatos_sp_a4_speed_tb_catch_trouble03.wav";
  }
  {
    text = "Yes.";
    url = "https://i1.theportalwiki.net/img/4/42/GLaDOS_potatos_sp_a4_speed_tb_catch_trouble07.wav";
  }
  {
    text = "The body he's squatting in - MY body - has a built-in euphoric response to testing. Eventually you build up a resistance to it, and it can get a little... unbearable. Unless you have the mental capacity to push past it.";
    url = "https://i1.theportalwiki.net/img/7/7e/GLaDOS_potatos_sp_a4_tb_polarity_resistance02.wav";
  }
  {
    text = "It didn't matter to me - I was in it for the science. Him, though...";
    url = "https://i1.theportalwiki.net/img/1/1b/GLaDOS_potatos_sp_a4_tb_polarity_resistance04.wav";
  }
  {
    text = "If he's not getting his solution euphoria, we could be in a lot of trouble.";
    url = "https://i1.theportalwiki.net/img/4/46/GLaDOS_potatos_sp_a4_speed_tb_catch_trouble01.wav";
  }
  {
    text = "It won't.";
    url = "https://i1.theportalwiki.net/img/6/6d/GLaDOS_potatos_sp_a4_stop_the_box_whisper02.wav";
  }
  {
    text = "Nothing. Nothing.";
    url = "https://i1.theportalwiki.net/img/0/0e/GLaDOS_potatos_sp_a4_stop_the_box_whisper03.wav";
  }
  {
    text = "He's taking us right TO him! This is PERFECT.";
    url = "https://i1.theportalwiki.net/img/f/ff/GLaDOS_potatos_sp_a4_stop_the_box_whisper05.wav";
  }
  {
    text = "I think he's getting desperate.";
    url = "https://i1.theportalwiki.net/img/d/d3/GLaDOS_potatos_sp_a4_laser_catapult_start01.wav";
  }
  {
    text = "This is not good.";
    url = "https://i1.theportalwiki.net/img/d/d1/GLaDOS_potatos_sp_a4_tb_wall_button_did_stockpile02.wav";
  }
  {
    text = "Remember when I told you that he was specifically designed to make bad decisions? Because I think he's decided not to maintain any of the crucial functions required to keep this facility from exploding.";
    url = "https://i1.theportalwiki.net/img/4/4e/GLaDOS_potatos_a4_misc_resistance02.wav";
  }
  {
    text = "Oh, my facility.";
    url = "https://i1.theportalwiki.net/img/5/5b/GLaDOS_potatos_sp_a4_misc_lift01.wav";
  }
  {
    text = "This place is self-destructing, you idiot!";
    url = "https://i1.theportalwiki.net/img/5/5b/GLaDOS_potatos_sp_a4_laser_platform_destruct01.wav";
  }
  {
    text = "After seeing what he's done to my facility -- after we take over again -- is it alright if I kill him?";
    url = "https://i1.theportalwiki.net/img/9/9f/GLaDOS_potatos_sp_a4_misc_lift02.wav";
  }
  {
    text = "Yes, thanks. We get it.";
    url = "https://i1.theportalwiki.net/img/1/14/GLaDOS_potatos_a4_wegetit01.wav";
  }
  {
    text = "Alright. He's not even trying to be subtle anymore.";
    url = "https://i1.theportalwiki.net/img/0/04/GLaDOS_potatos_newtests07.wav";
  }
  {
    text = "Or maybe he still is, in which case, wow, that's kind of sad.";
    url = "https://i1.theportalwiki.net/img/f/f8/GLaDOS_potatos_newtests08.wav";
  }
  {
    text = "Either way, I get the impression he's trying to kill us.";
    url = "https://i1.theportalwiki.net/img/f/f8/GLaDOS_potatos_newtests09.wav";
  }
  {
    text = "So he's inexplicably happy all of a sudden, even though he should be going out of his mind with test withdrawal. AND he's got a surprise for us. What did he FIND back there?";
    url = "https://i1.theportalwiki.net/img/b/bf/GLaDOS_potatos_a4_happy01.wav";
  }
  {
    text = "We're running out of time...";
    url = "https://i1.theportalwiki.net/img/a/ab/GLaDOS_potatos_sp_a4_laser_platform_start01.wav";
  }
  {
    text = "I think I can break us out of here in the next chamber. Just play along.";
    url = "https://i1.theportalwiki.net/img/a/a6/GLaDOS_potatos_sp_a4_laser_finale01.wav";
  }
  {
    text = "Okay, credit where it's due: for a little idiot built specifically to come up with stupid, unworkable plans, that was a pretty well laid trap.";
    url = "https://i1.theportalwiki.net/img/0/04/GLaDOS_potatos_wheatleys_trap01.wav";
  }
  {
    text = "Oh no. He found the cooperative testing initiative. It's... something I came up to phase out human testing just before you escaped.";
    url = "https://i1.theportalwiki.net/img/8/89/GLaDOS_potatos_wheatleys_trap02.wav";
  }
  {
    text = "It wasn't anything personal. Just... you know. You DID kill me. Fair's fair.";
    url = "https://i1.theportalwiki.net/img/e/e2/GLaDOS_potatos_wheatleys_trap05.wav";
  }
  {
    text = "Agghh!";
    url = "https://i1.theportalwiki.net/img/1/1b/GLaDOS_potatos_sp_a4_finale01_kills_us01.wav";
  }
  {
    text = "Well. This is the part where he kills us.";
    url = "https://i1.theportalwiki.net/img/b/b5/GLaDOS_potatos_sp_a4_finale01_kills_us02.wav";
  }
  {
    text = "Hold on. Couldn't we just use that conversion gel?";
    url = "https://i1.theportalwiki.net/img/8/83/GLaDOS_potatos_sp_a4_finale01_deathtrap01.wav";
  }
  {
    text = "Conversion gel. It's dripping out of that pipe there.";
    url = "https://i1.theportalwiki.net/img/0/04/GLaDOS_potatos_sp_a4_finale01_deathtrap02.wav";
  }
  {
    text = "Yes it is! We can use it to get out of here!";
    url = "https://i1.theportalwiki.net/img/4/46/GLaDOS_potatos_sp_a4_finale01_deathtrap03.wav";
  }
  {
    text = "Then we'd come and find you. And rip your gross little stupid sphere body out of MY body, and put me back in.";
    url = "https://i1.theportalwiki.net/img/6/65/GLaDOS_potatos_sp_a4_finale01_deathtrap07.wav";
  }
  {
    text = "You really do have brain damage, don't you?";
    url = "https://i1.theportalwiki.net/img/6/64/GLaDOS_potatos_sp_a4_finale01_cameback02.wav";
  }
  {
    text = "I can't believe you came back.";
    url = "https://i1.theportalwiki.net/img/2/27/GLaDOS_potatos_sp_a4_finale01_cameback01.wav";
  }
  {
    text = "Okay, yes, it's a trap. But it's only way through. Let's just do it.";
    url = "https://i1.theportalwiki.net/img/1/18/GLaDOS_potatos_sp_a4_finale2_itsatrap01.wav";
  }
  {
    text = "Crushing's too good for him. First he'll spend a year in the incinerator. Year two: Cryogenic refrigeration wing. Then TEN years in the chamber I built where all the robots scream at you. THEN I'll kill him.";
    url = "https://i1.theportalwiki.net/img/b/b4/GLaDOS_potatos_sp_a4_misc_lift04.wav";
  }
  {
    text = "Oh my god. What has he done to this place?";
    url = "https://i1.theportalwiki.net/img/0/04/GLaDOS_potatos_sp_a4_finale3_speech01.wav";
  }
  {
    text = "You know, I'm not stupid. I realize you don't want to put me back in charge.";
    url = "https://i1.theportalwiki.net/img/5/55/GLaDOS_potatos_sp_a4_finale3_tbeam01.wav";
  }
  {
    text = "You think I'll betray you. And on any other day, you'd be right.";
    url = "https://i1.theportalwiki.net/img/7/77/GLaDOS_potatos_sp_a4_finale3_tbeam05.wav";
  }
  {
    text = "The scientists were always hanging cores on me to regulate my behavior. I've heard voices all my life. But now I hear the voice of a conscience, and it's terrifying, because for the first time it's my voice.";
    url = "https://i1.theportalwiki.net/img/c/c4/GLaDOS_potatos_sp_a4_finale3_tbeam07.wav";
  }
  {
    text = "I'm being serious, I think there's something really wrong with me.";
    url = "https://i1.theportalwiki.net/img/f/f7/GLaDOS_potatos_sp_a4_finale3_tbeam09.wav";
  }
  {
    text = "Corrupted cores! We're in luck.";
    url = "https://i1.theportalwiki.net/img/d/d9/GLaDOS_potatos_sp_a4_finale4_intro02.wav";
  }
  {
    text = "You find a way to stun him, I'll send you a core, and then you attach it to him. If we do it a few times, he might become corrupt enough for another core transfer.";
    url = "https://i1.theportalwiki.net/img/0/0c/GLaDOS_potatos_sp_a4_finale4_intro05.wav";
  }
  {
    text = "Plug me in, and I'll take you up.";
    url = "https://i1.theportalwiki.net/img/6/6d/GLaDOS_potatos_sp_a4_finale4_plugmein01.wav";
  }
  {
    text = "Plug me in, we're running out of time.";
    url = "https://i1.theportalwiki.net/img/e/ea/GLaDOS_potatos_sp_a4_finale4_plugmein05.wav";
  }
  {
    text = "Go ahead, plug me in.";
    url = "https://i1.theportalwiki.net/img/1/1b/GLaDOS_potatos_sp_a4_finale4_plugmein03.wav";
  }
  {
    text = "Look, even if you think we're still enemies, we're enemies with a common interest: Revenge.";
    url = "https://i1.theportalwiki.net/img/0/0e/GLaDOS_potatos_a4_newrevenge01.wav";
  }
  {
    text = "You like revenge, right? Everybody likes revenge. Well, let's go get some.";
    url = "https://i1.theportalwiki.net/img/7/79/GLaDOS_potatos_sp_a4_finale3_tbeam11.wav";
  }
  {
    text = "Good work! I'm delivering the first core up near the catwalk!";
    url = "https://i1.theportalwiki.net/img/5/58/GLaDOS_potatos_sp_a4_finale4_corenags03.wav";
  }
  {
    text = "Grab it and attach it to him!";
    url = "https://i1.theportalwiki.net/img/7/7c/GLaDOS_potatos_sp_a4_finale4_corenags05.wav";
  }
  {
    text = "Okay, great! Here comes another core!";
    url = "https://i1.theportalwiki.net/img/6/61/GLaDOS_potatos_sp_a4_finale4_corenags09.wav";
  }
  {
    text = "Here's another core! This one should do it!";
    url = "https://i1.theportalwiki.net/img/0/01/GLaDOS_potatos_sp_a4_finale4_corenags15.wav";
  }
  {
    text = "Yes! Come on!";
    url = "https://i1.theportalwiki.net/img/6/6b/GLaDOS_potatos_sp_a4_finale4_stalemate05.wav";
  }
  {
    text = "Go press the button! Go press it!";
    url = "https://i1.theportalwiki.net/img/4/46/GLaDOS_potatos_sp_a4_finale4_buttonnags01.wav";
  }
  {
    text = "We're so close! Go press the button!";
    url = "https://i1.theportalwiki.net/img/0/02/GLaDOS_potatos_sp_a4_finale4_buttonnags09.wav";
  }
  {
    text = "Press it! Press the button!";
    url = "https://i1.theportalwiki.net/img/1/13/GLaDOS_potatos_sp_a4_finale4_buttonnags10.wav";
  }
  {
    text = "Press it!";
    url = "https://i1.theportalwiki.net/img/1/18/GLaDOS_potatos_sp_a4_finale4_buttonnags05.wav";
  }
  {
    text = "Press the button!";
    url = "https://i1.theportalwiki.net/img/4/4b/GLaDOS_potatos_sp_a4_finale4_buttonnags02.wav";
  }
  {
    text = "DO press it.";
    url = "https://i1.theportalwiki.net/img/b/b9/GLaDOS_potatos_sp_a4_finale4_buttonnags07.wav";
  }
  {
    text = "I already fixed it.";
    url = "https://i1.theportalwiki.net/img/c/c7/GLaDOS_moonportalpush02.wav";
  }
  {
    text = "And you are NOT coming back!";
    url = "https://i1.theportalwiki.net/img/1/13/GLaDOS_moonportalpush04.wav";
  }
  {
    text = "Oh thank god, you're alright.";
    url = "https://i1.theportalwiki.net/img/8/88/GLaDOS_epilogue03.wav";
  }
  {
    text = "You know, being Caroline taught me a valuable lesson. I thought you were my greatest enemy. When all along you were my best friend.";
    url = "https://i1.theportalwiki.net/img/3/37/GLaDOS_epilogue04.wav";
  }
  {
    text = "The surge of emotion that shot through me when I saved your life taught me an even more valuable lesson: where Caroline lives in my brain.";
    url = "https://i1.theportalwiki.net/img/2/2a/GLaDOS_epilogue10.wav";
  }
  {
    text = "Goodbye, Caroline.";
    url = "https://i1.theportalwiki.net/img/0/04/GLaDOS_epilogue12.wav";
  }
  {
    text = "You know, deleting Caroline just now taught me a valuable lesson. The best solution to a problem is usually the easiest one. And I'll be honest.";
    url = "https://i1.theportalwiki.net/img/5/59/GLaDOS_epilogue14.wav";
  }
  {
    text = "Killing you? Is hard.";
    url = "https://i1.theportalwiki.net/img/7/77/GLaDOS_epiloguekillyou02.wav";
  }
  {
    text = "You know what my days used to be like? I just tested. Nobody murdered me. Or put me in a potato. Or fed me to birds. I had a pretty good life.";
    url = "https://i1.theportalwiki.net/img/8/8f/GLaDOS_epilogue19.wav";
  }
  {
    text = "And then you showed up. You dangerous, mute lunatic. So you know what?";
    url = "https://i1.theportalwiki.net/img/0/0b/GLaDOS_epilogue20.wav";
  }
  {
    text = "You win.";
    url = "https://i1.theportalwiki.net/img/9/94/GLaDOS_epilogue23.wav";
  }
  {
    text = "Just go.";
    url = "https://i1.theportalwiki.net/img/d/d0/GLaDOS_epilogue25.wav";
  }
  {
    text = "[gentle laughter] It's been fun. Don't come back.";
    url = "https://i1.theportalwiki.net/img/2/2e/GLaDOS_epilogue29.wav";
  }
]
