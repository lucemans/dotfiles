{ config, pkgs, ... }:

{
  imports =
    [
      ./hardware-configuration.nix  # Auto-generated by the NixOS installer
      ./../modules/system-packages.nix  # Import extra package list
    ];

  # Add at the top level of the configuration
  system.stateVersion = "25.05";

  # Bootloader
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.initrd.luks.devices."luks-c8850dca-9dcf-4e50-aa4c-2920de3c23b2".device = "/dev/disk/by-uuid/c8850dca-9dcf-4e50-aa4c-2920de3c23b2";

  # Networking
  networking.hostName = "v3x-patch";
  networking.networkmanager.enable = true;

  # Locale with Flakes
  time.timeZone = "Europe/Amsterdam";
  i18n.defaultLocale = "en_US.UTF-8";

  # Enable Plasma
  services.xserver.enable = true;
  services.displayManager.sddm.enable = true;
  services.desktopManager.plasma6.enable = true;

  # Enable mullvad
  services.mullvad-vpn.enable = true;

  # Configure keymap in X11
  services.xserver.xkb = {
    layout = "us";
    variant = "";
  };

  # Enable CUPS to print documents.
  services.printing.enable = true;

  # Enable sound with PipeWire
  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
    # If you want to use JACK applications, uncomment this
    #jack.enable = true;

    # use the example session manager (no others are packaged yet so this is enabled by default,
    # no need to redefine it in your config for now)
    #media-session.enable = true;
  };

  # Enable Fish shell system-wide
  programs.fish.enable = true;

  # Enable Steam
  programs.steam = {
    enable = true;
    remotePlay.openFirewall = true; # Open ports in the firewall for Steam Remote Play
    dedicatedServer.openFirewall = true; # Open ports in the firewall for Source Dedicated Server
    localNetworkGameTransfers.openFirewall = true; # Open ports in the firewall for Steam Local Network Game Transfers
  };

  hardware.graphics = {
    enable = true;
  };

  # Udev rules for RTL-SDR and plugdev group
  services.udev.packages = [ pkgs.rtl-sdr ];
  users.groups.plugdev = {};

  # Blacklist conflicting DVB kernel modules so rtl-sdr can access the device
  boot.blacklistedKernelModules = [ "dvb_usb_rtl28xxu" "rtl2832" "rtl2832_sdr" ];

  # Avahi (mDNS) to avoid avahi_service_browser_new() Bad state errors
  services.avahi = {
    enable = true;
    nssmdns4 = true;
  };

  # Define user
  users.users.luc = {
    isNormalUser = true;
    extraGroups = [ "wheel" "networkmanager" "docker" "plugdev" ];
    shell = pkgs.fish;
  };

  # Add Fish to /etc/shells
  environment.shells = with pkgs; [ fish ];

  # Allow unfree packages
  nixpkgs.config.allowUnfree = true;

  # Enable flakes
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
}
